<form class="{{cssClass}} gum-item-sheet trigger-sheet condition-sheet effect-sheet" autocomplete="off">

    {{!-- Cabeçalho Padrão --}}
    <header class="sheet-header">
        <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <div class="header-info">
            <div class="header-main-line">
                <textarea name="name" rows="1" placeholder="{{localize "GUM.TriggerSheet.NamePlaceholder"}}">{{item.name}}</textarea>
            </div>
            <div class="header-subline">
                <span class="item-type-tag">{{localize "GUM.TriggerSheet.Type"}}</span>
            </div>
                <span class="header-divider" aria-hidden="true"></span>
            </div>
    </header>

    <section class="sheet-content">
    {{!-- NAVEGAÇÃO DAS ABAS --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="detalhes">{{localize "GUM.TriggerSheet.Description"}}</a>
        <a class="item" data-tab="codigo">{{localize "GUM.TriggerSheet.Code"}}</a>
    </nav>

        <div class="sheet-body-content">

            {{!-- ABA DE CÓDIGO --}}
            <div class="tab" data-group="primary" data-tab="codigo">
                <section class="form-section condition-card">
                    <div class="section-header">
                        <div>
                            <h4 class="section-title">{{localize "GUM.TriggerSheet.Type"}}</h4>
                        </div>
                    </div>
                    <p class="hint">{{localize "GUM.TriggerSheet.Hint"}}</p>
                    <div class="condition-input-area">
                       <textarea name="system.code" rows="10" placeholder="{{localize "GUM.TriggerSheet.CodePlaceholder"}}">{{system.code}}</textarea>
                    </div>
                </section>
            </div>

            {{!-- ABA DE DETALHES --}}
            <div class="tab" data-group="primary" data-tab="detalhes">
                <div class="description-tab">
                    <div class="description-grid">
                        <div class="form-section description-section itemdesc-block">
                            <details class="itemdesc-panel" open>
                                <summary class="itemdesc-block-header">
                                    <h4 class="itemdesc-block-title">{{localize "GUM.TriggerSheet.FullDescription"}}</h4>
                                </summary>
                                {{#if editable}}
                                <span class="itemdesc-header-actions">
                                        <button type="button" class="toggle-editor itemdesc-edit-button" data-field="system.description" title="{{localize "GUM.Common.Edit"}}" aria-label="{{localize "GUM.Common.Edit"}}">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                </span>
                                {{/if}}
                                <div class="itemdesc-content">
                                    <div class="description-view itemdesc-inner">{{{enrichedDescription}}}</div>

                                    <div class="description-editor itemdesc-inner" style="display:none;">
                                        {{editor system.description target="system.description" engine="prosemirror" owner=owner editable=editable}}
                                        <div class="description-actions">
                                            <button type="button" class="save-description" data-field="system.description"><i class="fas fa-save"></i> {{localize "GUM.Common.Save"}}</button>
                                            <button type="button" class="expand-description" data-expanded="false"><i class="fas fa-expand"></i> {{localize "GUM.Common.Expand"}}</button>
                                            <button type="button" class="cancel-description"><i class="fas fa-times"></i> {{localize "GUM.Common.Cancel"}}</button>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        </div>

                        <div class="form-section description-section itemdesc-block">
                            <details class="itemdesc-panel" open>
                                <summary class="itemdesc-block-header">
                                    <h4 class="itemdesc-block-title">{{localize "GUM.TriggerSheet.ChatDescription"}}</h4>
                                </summary>
                                {{#if editable}}
                                <span class="itemdesc-header-actions">
                                        <button type="button" class="toggle-editor itemdesc-edit-button" data-field="system.chat_description" title="{{localize "GUM.Common.Edit"}}" aria-label="{{localize "GUM.Common.Edit"}}">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                </span>
                                {{/if}}
                                <div class="itemdesc-content">
                                    <div class="description-view itemdesc-inner">{{{enrichedChatDescription}}}</div>

                                    <div class="description-editor itemdesc-inner" style="display:none;">
                                        {{editor system.chat_description target="system.chat_description" engine="prosemirror" owner=owner editable=editable}}
                                        <div class="description-actions">
                                            <button type="button" class="save-description" data-field="system.chat_description"><i class="fas fa-save"></i> {{localize "GUM.Common.Save"}}</button>
                                            <button type="button" class="expand-description" data-expanded="false"><i class="fas fa-expand"></i> {{localize "GUM.Common.Expand"}}</button>
                                            <button type="button" class="cancel-description"><i class="fas fa-times"></i> {{localize "GUM.Common.Cancel"}}</button>
                                        </div>
                                    </div>
                                </div>
                            </details>
                            </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
</form>