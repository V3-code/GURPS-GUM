    <div class="modifiers-tab">
      <div class="eqpmod-block">

        {{!-- Header padrão + plus minimalista --}}
        <div class="eqpmod-block-header">
          <h4 class="eqpmod-block-title">Modificadores</h4>
          <a class="eqpmod-add-button add-modifier" title="Adicionar Modificador">
            <i class="fas fa-plus"></i>
          </a>
        </div>

        {{!-- Lista em linhas (mesma do eqp_modifiers) --}}
        <ol class="eqpmod-line-list">
          {{#each sortedModifiers as |modifier|}}
            <li class="eqpmod-line-item {{#if modifier.isLimitation}}is-limitation{{else}}is-enhancement{{/if}}"
                data-modifier-id="{{modifier.id}}">
              <div class="eqpmod-line">

                {{!-- Identidade: ícone + nome --}}
                <div class="eqpmod-cell eqpmod-identity">
                  {{#if modifier.img}}
                    <img src="{{modifier.img}}" class="eqpmod-icon" />
                  {{else}}
                    <img src="icons/svg/aura.svg" class="eqpmod-icon" />
                  {{/if}}

                  <div class="eqpmod-text">
                    <div class="eqpmod-name">{{modifier.name}}</div>
                        {{!-- Subline discreta: efeito aplicado --}}
                        {{#if modifier.applied_effect}}
                            <div class="eqpmod-subline">{{modifier.applied_effect}}</div>
                        {{/if}}
                  </div>
                </div>


                {{!-- Custo (%) --}}
                <div class="eqpmod-cell eqpmod-stat is-center">
                  <div class="eqpmod-label">Custo</div>
                  <div class="eqpmod-value">{{modifier.cost}}</div>
                </div>

                {{!-- Nível --}}
                <div class="eqpmod-cell eqpmod-stat is-center">
                  <div class="eqpmod-label">Nível</div>
                  <div class="eqpmod-value">{{modifier.level}}</div>
                </div>

                {{!-- Ações --}}
                <div class="eqpmod-cell eqpmod-actions">
                  <span class="eqpmod-controls">
                    <a class="view-modifier" title="Visualizar Detalhes" data-modifier-id="{{modifier.id}}">
                      <i class="fas fa-eye"></i>
                    </a>
                    <a class="delete-modifier" title="Remover" data-modifier-id="{{modifier.id}}">
                      <i class="fas fa-trash"></i>
                    </a>
                  </span>
                </div>

              </div>
            </li>

          {{else}}
            <li class="eqpmod-empty">Nenhum modificador aplicado.</li>
          {{/each}}
        </ol>

      </div>
    </div>

  {{/if}}
</div>

       
       {{!-- ===================================================================== --}}
    {{!--           ABA ESPECIAL: MODIFICADORES DE EQUIPAMENTO                  --}}
    {{!-- ===================================================================== --}}
    <div class="tab" data-tab="eqp_modifiers">
        {{#if (eq item.type "equipment")}}
            
<div class="modifiers-tab">
  <div class="eqpmod-block">

    {{!-- Header vermelho + plus minimalista --}}
    <div class="eqpmod-block-header">
      <h4 class="eqpmod-block-title">Modificadores de Equipamento</h4>
      <a class="eqpmod-add-button add-eqp-modifier" title="Adicionar Modificador"><i class="fas fa-plus"></i></a>
    </div>

    {{!-- Lista em linhas --}}
    <ol class="eqpmod-line-list">
      {{#each eqpModifiersList as |mod|}}
        <li class="eqpmod-line-item" data-modifier-id="{{mod.id}}">
          <div class="eqpmod-line">

            {{!-- Identidade: ícone + nome --}}
            <div class="eqpmod-cell eqpmod-identity">
              <input type="checkbox" name="system.eqp_modifiers.{{mod.id}}.enabled" {{checked mod.enabled}} title="Modificador habilitado" aria-label="Habilitar {{mod.name}}"/>
              {{#if mod.img}}
                <img src="{{mod.img}}" class="eqpmod-icon" />
              {{else}}
                <img src="icons/svg/item-bag.svg" class="eqpmod-icon" />
              {{/if}}

              <div class="eqpmod-text">
                <div class="eqpmod-name">{{mod.name}}{{#if (eq mod.source_type "effect")}} <span class="eqpmod-subline">Efeito</span>{{/if}}</div>
                <div class="eqpmod-subline">Nível <input type="number" min="0" step="1" name="system.eqp_modifiers.{{mod.id}}.level" value="{{mod.level}}" style="width: 52px;"/></div>
              </div>
            </div>

            {{!-- CF --}}
            <div class="eqpmod-cell eqpmod-stat is-center">
              <div class="eqpmod-label">CF</div>
              <div class="eqpmod-value">{{mod.costDisplay}}</div>
            </div>

            {{!-- Peso --}}
            <div class="eqpmod-cell eqpmod-stat is-center">
              <div class="eqpmod-label">Peso</div>
              <div class="eqpmod-value">{{mod.weightDisplay}}</div>
            </div>

            {{!-- Ações --}}
            <div class="eqpmod-cell eqpmod-actions">
              <span class="eqpmod-controls">
                {{!-- se você já tiver handler "view", mantenha essa classe; se não, deixa só o delete --}}
                <a class="view-eqp-modifier" title="Visualizar"><i class="fas fa-eye"></i></a>
                {{#unless (eq mod.source_type "effect")}}
                <a class="delete-eqp-modifier" title="Remover"><i class="fas fa-trash"></i></a>
                {{/unless}}
              </span>
            </div>
          </div>

          {{!-- Opcional: notas/efeitos em linha extra bem discreta --}}
          {{#if mod.features}}
            <div class="eqpmod-subline">{{mod.features}}</div>
          {{/if}}
        </li>
      {{else}}
        <li class="eqpmod-empty">Nenhum modificador de equipamento aplicado.</li>
      {{/each}}
    </ol>

    <div class="form-section" style="margin-top: 10px;">
      <h4 class="section-title">Resultado resolvido</h4>
      <div class="form-grid-2">
        <div class="form-group"><label>Preço unitário</label><strong>{{finalCostString}}</strong><span class="notes">Base: {{system.cost}}</span></div>
        <div class="form-group"><label>Peso unitário</label><strong>{{finalWeightString}} kg</strong><span class="notes">Base: {{system.weight}} kg</span></div>
      </div>
      {{#if equipmentCostSteps.length}}
      <div class="equipment-feature-trace equipment-calculation-trace">
        <strong>Memória do preço</strong>
        <ol>{{#each equipmentCostSteps as |step|}}<li><span>{{step.stageLabel}}: {{step.input}} → <strong>{{step.output}}</strong></span>{{#each step.entries as |entry|}}<span class="notes">{{entry.sourceName}}: {{entry.expression}} (escala {{entry.scale}})</span>{{/each}}</li>{{/each}}</ol>
      </div>
      {{/if}}
      {{#if equipmentWeightSteps.length}}
      <div class="equipment-feature-trace equipment-calculation-trace">
        <strong>Memória do peso</strong>
        <ol>{{#each equipmentWeightSteps as |step|}}<li><span>{{step.stageLabel}}: {{step.input}} → <strong>{{step.output}}</strong></span>{{#each step.entries as |entry|}}<span class="notes">{{entry.sourceName}}: {{entry.expression}} (escala {{entry.scale}})</span>{{/each}}</li>{{/each}}</ol>
      </div>
      {{/if}}
      {{#if equipmentFeatureSteps.length}}
      <div class="equipment-feature-trace">
        <strong>Memória das features</strong>
        <ol>
          {{#each equipmentFeatureSteps as |step|}}
          <li>
            <span>{{step.sourceName}} — {{step.label}}</span>
            {{#if step.path}}<code>{{step.path}}</code>{{/if}}
            {{#if step.attackId}}<span class="notes">({{step.attackType}}: {{step.attackId}})</span>{{/if}}
            {{#if step.path}}<span class="notes">{{step.input}} → <strong>{{step.output}}</strong></span>{{/if}}
            {{#if step.effectUuid}}<span class="notes">{{step.domain}} · {{step.effectUuid}}</span>{{/if}}
          </li>
          {{/each}}
        </ol>
      </div>
      {{/if}}
      {{#if equipmentResolutionWarnings.length}}
      <div class="equipment-resolution-warnings">
        <strong><i class="fas fa-triangle-exclamation"></i> Avisos da resolução</strong>
        <ul>{{#each equipmentResolutionWarnings as |warning|}}<li><strong>{{warning.source}}:</strong> {{warning.message}}</li>{{/each}}</ul>
      </div>
      {{/if}}
    </div>

  </div>
</div>


        {{/if}}
    </div>
   </section>
</section>
