{{!-- Definindo o partial 'inline' no topo do arquivo --}}
{{#*inline "itemDetailsGeneral"}}
    <div class="equipment-details-layout">
        {{!-- Este bloco contém os campos gerais para equipamentos. --}}
        <div class="equipment-operational-toggle">
            <label class="custom-checkbox" title="Indica que o equipamento está ligado ou em funcionamento. Controla somente features configuradas como Enquanto ativado; não substitui Carregado ou Equipado.">
                <input type="checkbox" name="system.active" {{checked system.active}}/>
                <span><i class="fas fa-power-off"></i> Ligado / Ativo</span>
                <small class="notes">Estado operacional usado por efeitos “Enquanto ativado”.</small>
            </label>
        </div>
        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">Geral</h4>
            <div class="equipment-general-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-coins"></i><span>Custo ($)</span></label>
                    <div class="equipment-stat-control">
                        {{#if hasCostChange}}
                            <div class="equipment-calculated-value">
                                <input type="number" step="0.01" name="system.cost" value="{{system.cost}}" title="Custo Base"/>
                                <div class="equipment-final-value" title="Custo Final">
                                    <i class="fas fa-arrow-right"></i>
                                    <span>{{finalCostString}}</span>
                                </div>
                            </div>
                        {{else}}
                            <input type="number" step="0.01" name="system.cost" value="{{system.cost}}"/>
                        {{/if}}
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-weight-hanging"></i><span>Peso (kg)</span></label>
                    <div class="equipment-stat-control">
                        {{#if hasWeightChange}}
                            <div class="equipment-calculated-value">
                                <input type="number" step="0.01" name="system.weight" value="{{system.weight}}" title="Peso Base"/>
                                <div class="equipment-final-value" title="Peso Final">
                                    <i class="fas fa-arrow-right"></i>
                                    <span>{{finalWeightString}}</span>
                                </div>
                            </div>
                        {{else}}
                            <input type="number" step="0.01" name="system.weight" value="{{system.weight}}"/>
                        {{/if}}
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-cubes"></i><span>Quantidade</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" name="system.quantity" value="{{system.quantity}}"/>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Nível Tecnológico"><i class="fas fa-microchip"></i><span>Nível Tecnológico</span></label>
                    <div class="equipment-stat-control">
                        <input type="text" name="system.tech_level" value="{{system.tech_level}}"/>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Classe de Legalidade"><i class="fas fa-balance-scale"></i><span>Classe de Legalidade</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value">
                            <input type="text" name="system.legality_class" value="{{system.legality_class}}" title="Valor base"/>
                            {{#if equipmentPropertyChanges.legality_class.changed}}
                            <div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.legality_class.final}}</span></div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">Propriedades Físicas</h4>
            <div class="equipment-text-grid">
                <div class="equipment-field-card">
                    <label class="equipment-stat-heading"><i class="fas fa-gem"></i><span>Qualidade</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value">
                            <input type="text" name="system.quality" value="{{system.quality}}" placeholder="Ex: Fina, Barata" title="Valor base"/>
                            {{#if equipmentPropertyChanges.quality.changed}}
                            <div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.quality.final}}</span></div>
                            {{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-field-card">
                    <label class="equipment-stat-heading"><i class="fas fa-cubes"></i><span>Material</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value">
                            <input type="text" name="system.material" value="{{system.material}}" placeholder="Ex: Aço, Madeira" title="Valor base"/>
                            {{#if equipmentPropertyChanges.material.changed}}
                            <div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.material.final}}</span></div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>

            <div class="equipment-physical-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Modificador de Tamanho (SM)"><i class="fas fa-expand-arrows-alt"></i><span>MT do Item</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.tech_sm" value="{{system.tech_sm}}" placeholder="+0" title="Valor base"/>
                            {{#if equipmentPropertyChanges.tech_sm.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.tech_sm.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Resistência a Dano do próprio Item"><i class="fas fa-shield-alt"></i><span>RD do Item</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.item_dr" value="{{system.item_dr}}" title="Valor base"/>
                            {{#if equipmentPropertyChanges.item_dr.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.item_dr.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Pontos de Vida do Item"><i class="fas fa-heart"></i><span>PV do Item</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.item_hp" value="{{system.item_hp}}" title="Valor base"/>
                            {{#if equipmentPropertyChanges.item_hp.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.item_hp.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Vitalidade (HT) do Item"><i class="fas fa-heartbeat"></i><span>HT do Item</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.item_ht" value="{{system.item_ht}}" title="Valor base"/>
                            {{#if equipmentPropertyChanges.item_ht.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.item_ht.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">Usos e Consumo</h4>
            <div class="equipment-defense-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-flask"></i><span>Modo de consumo</span></label>
                    <div class="equipment-stat-control"><select name="system.uses_mode"><option value="quantity" {{#if (eq system.uses_mode "quantity")}}selected{{/if}}>Consumir quantidade</option><option value="charges" {{#if (eq system.uses_mode "charges")}}selected{{/if}}>Usar cargas</option></select></div>
                </div>
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-battery-full"></i><span>Cargas máximas</span></label>
                    <div class="equipment-stat-control"><div class="equipment-calculated-value"><input type="number" min="0" name="system.max_uses" value="{{system.max_uses}}" title="Valor base"/>
                        {{#if equipmentPropertyChanges.max_uses.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.max_uses.final}}</span></div>{{/if}}
                    </div></div>
                </div>
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-battery-half"></i><span>Cargas gastas</span></label>
                    <div class="equipment-stat-control"><input type="number" min="0" name="system.current_uses" value="{{system.current_uses}}"/></div>
                    {{#if (eq equipmentUses.mode "charges")}}<small class="notes">Restantes: {{equipmentUses.remaining}} / {{equipmentUses.max}}</small>{{/if}}
                </div>
                <label class="equipment-stat-card custom-checkbox" title="Ao gastar a última carga, reduz a quantidade em um e recarrega a próxima unidade.">
                    <span class="equipment-stat-heading"><i class="fas fa-box-open"></i><span>Consumir unidade ao esgotar</span></span>
                    <input type="checkbox" name="system.consume_quantity_when_empty" {{checked system.consume_quantity_when_empty}}/>
                </label>
            </div>
            <p class="notes">No modo Quantidade, “Consumir / Usar” mantém o comportamento legado e reduz uma unidade. No modo Cargas, o campo acima registra cargas gastas.</p>
        </div>

        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">Uso & Defesa</h4>
            <div class="equipment-defense-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Penalidade de Ocultamento (Holdout)"><i class="fas fa-user-secret"></i><span>Ocultação</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.holdout" value="{{system.holdout}}" placeholder="0" title="Valor base"/>
                            {{#if equipmentPropertyChanges.holdout.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.holdout.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Tempo para equipar/vestir em segundos"><i class="fas fa-stopwatch"></i><span>Tempo para Vestir (s)</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.equip_time" value="{{system.equip_time}}" title="Valor base"/>
                            {{#if equipmentPropertyChanges.equip_time.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.equip_time.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading" title="Bônus de Defesa (DB) para Escudos ou Capas"><i class="fas fa-shield-alt"></i><span>Bônus de Defesa</span></label>
                    <div class="equipment-stat-control">
                        <div class="equipment-calculated-value"><input type="number" name="system.defense_bonus" value="{{system.defense_bonus}}" title="Valor base"/>
                            {{#if equipmentPropertyChanges.defense_bonus.changed}}<div class="equipment-final-value" title="Valor final após modificadores"><i class="fas fa-arrow-right"></i><span>{{equipmentPropertyChanges.defense_bonus.final}}</span></div>{{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {{#if (eq item.type "equipment")}}
        <div class="form-section skill-details-compact equipment-details-form">
            <h4 class="section-title">Capacidades</h4>
            <div class="equipment-container-toggle">
                <label class="custom-checkbox inline-checkbox">
                    <input type="checkbox" name="system.is_container" {{checked system.is_container}} />
                    <i class="fas fa-box-open"></i>
                    <span>É um recipiente / contêiner</span>
                </label>
            </div>

            <div class="equipment-capacity-grid">
                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-weight-hanging"></i><span>Capacidade de Peso (kg)</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.01" min="0" name="system.container.max_weight" value="{{system.container.max_weight}}" />
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-expand-arrows-alt"></i><span>Largura (cm)</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.1" min="0" name="system.container.dimensions_cm.width" value="{{system.container.dimensions_cm.width}}" />
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-expand-arrows-alt"></i><span>Altura (cm)</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.1" min="0" name="system.container.dimensions_cm.height" value="{{system.container.dimensions_cm.height}}" />
                    </div>
                </div>

                <div class="equipment-stat-card">
                    <label class="equipment-stat-heading"><i class="fas fa-expand-arrows-alt"></i><span>Profundidade (cm)</span></label>
                    <div class="equipment-stat-control">
                        <input type="number" step="0.1" min="0" name="system.container.dimensions_cm.depth" value="{{system.container.dimensions_cm.depth}}" />
                    </div>
                </div>
            </div>
        </div>
        {{/if}}
    </div>
{{/inline}}

{{!-- ======================================================== --}}
{{!--        NOVA ABA DE EFEITOS (ESTRUTURA VERSÃO 3)        --}}
{{!-- ======================================================== --}}
{{#*inline "effectsTab"}}
    <div class="effects-tab-layout">
        <div class="effects-columns">

        {{!-- ================================================== --}}
        {{!-- EM SUCESSO --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">Em Sucesso</h4>
            <a class="effects-add-button add-effect" data-target-list="activationEffects.success" title="Adicionar Efeito em Sucesso"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.activation.success as |effect|}}
                <li class="effects-line-item" data-list-name="activationEffects.success" data-effect-id="{{effect.id}}">
                <div class="effects-line effects-line-basic">
                    {{!-- Coluna: ícone + nome --}}
                    <div class="effects-cell effects-identity">
                    <img src="{{effect.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{effect.name}}</div>
                    </div>
                    </div>

                    {{!-- Coluna: destinatário --}}
                    <div class="effects-cell effects-recipient">
                    <div class="effects-label">Dest.</div>
                    <select name="system.activationEffects.success.{{effect.id}}.recipient">
                        <option value="self" {{#if (eq effect.recipient 'self')}}selected{{/if}}>Próprio</option>
                        <option value="target" {{#if (eq effect.recipient 'target')}}selected{{/if}}>Alvo</option>
                    </select>
                    </div>

                    {{!-- Coluna: ações --}}
                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-effect" title="Ver Efeito Original" data-uuid="{{effect.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="Remover Efeito"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">Nenhum efeito.</li>
            {{/each}}
            </ol>

        </div>

        {{!-- ================================================== --}}
        {{!-- EM FALHA --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">Em Falha</h4>
            <a class="effects-add-button add-effect" data-target-list="activationEffects.failure" title="Adicionar Efeito em Falha"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.activation.failure as |effect|}}
                <li class="effects-line-item" data-list-name="activationEffects.failure" data-effect-id="{{effect.id}}">
                <div class="effects-line effects-line-basic">
                    <div class="effects-cell effects-identity">
                    <img src="{{effect.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{effect.name}}</div>
                    </div>
                    </div>

                    <div class="effects-cell effects-recipient">
                    <div class="effects-label">Dest.</div>
                    <select name="system.activationEffects.failure.{{effect.id}}.recipient">
                        <option value="self" {{#if (eq effect.recipient 'self')}}selected{{/if}}>Próprio</option>
                        <option value="target" {{#if (eq effect.recipient 'target')}}selected{{/if}}>Alvo</option>
                    </select>
                    </div>

                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-effect" title="Ver Efeito Original" data-uuid="{{effect.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="Remover Efeito"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">Nenhum efeito.</li>
            {{/each}}
            </ol>
        </div>

        {{!-- ================================================== --}}
        {{!-- AO CAUSAR DANO --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">Ao Causar Dano</h4>
            <a class="effects-add-button add-effect" data-target-list="onDamageEffects" title="Adicionar Efeito ao Causar Dano"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.onDamage as |effect|}}
                <li class="effects-line-item" data-list-name="onDamageEffects" data-effect-id="{{effect.id}}">
                <div class="effects-line effects-line-damage">
                    <div class="effects-cell effects-identity">
                    <img src="{{effect.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{effect.name}}</div>
                    </div>
                    </div>

                    <div class="effects-cell is-center">
                    <div class="effects-label">Lesão</div>
                    <input class="effects-mini-input" type="number" name="system.onDamageEffects.{{effect.id}}.minInjury" value="{{effect.minInjury}}" placeholder="1"/>
                    </div>

                    <div class="effects-cell">
                    <div class="effects-label">Tipo</div>
                    <input class="effects-mini-input" type="text" name="system.onDamageEffects.{{effect.id}}.requiredDamageType" value="{{effect.requiredDamageType}}" placeholder="Qualquer"/>
                    </div>

                    <div class="effects-cell is-center">
                    <div class="effects-label">Chance</div>
                    <input class="effects-mini-input" type="number" name="system.onDamageEffects.{{effect.id}}.activationChance" value="{{effect.activationChance}}" placeholder="100"/>
                    </div>

                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-effect" title="Ver Efeito Original" data-uuid="{{effect.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="Remover Efeito"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">Nenhum efeito.</li>
            {{/each}}
            </ol>
        </div>

        {{!-- ================================================== --}}
        {{!-- EFEITOS PASSIVOS --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">Aplicação Automática</h4>
            <a class="effects-add-button add-effect" data-target-list="passiveEffects" title="Adicionar Efeito de Aplicação Automática"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.passive as |effect|}}
                <li class="effects-line-item" data-list-name="passiveEffects" data-effect-id="{{effect.id}}">
                <div class="effects-line effects-line-passive">
                    <div class="effects-cell effects-identity">
                    <img src="{{effect.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{effect.name}}</div>
                    </div>
                    </div>

                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-effect" title="Ver Efeito Original" data-uuid="{{effect.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="Remover Efeito"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">Nenhum efeito.</li>
            {{/each}}
 </ol>
 </div>

        {{!-- ================================================== --}}
        {{!-- EFEITOS DE ESTADO --}}
        {{!-- ================================================== --}}
        <div class="effects-block state-effects-block">
            <div class="effects-block-header">
                <div><h4 class="effects-block-title" title="Grupos ativados manualmente ou pelo estado do item.">Efeitos de Estado</h4></div>
                <a class="effects-add-button add-state-effect-group" title="Adicionar grupo de efeitos"><i class="fas fa-plus"></i></a>
            </div>
            {{#each system.preparedEffects.stateGroups as |group|}}
            <section class="state-effect-group" data-state-group-id="{{group.id}}">
                <div class="state-effect-group-header">
                    <input type="text" name="system.stateEffectGroups.{{group.id}}.name" value="{{group.name}}" placeholder="Nome do grupo" />
                    <select name="system.stateEffectGroups.{{group.id}}.mode" title="Modo de ativação">
                        <option value="manual" {{#if (eq group.mode "manual")}}selected{{/if}}>Manual</option>
                        <option value="equipped" {{#if (eq group.mode "equipped")}}selected{{/if}}>Enquanto equipado</option>
                        <option value="carried" {{#if (eq group.mode "carried")}}selected{{/if}}>Enquanto carregado</option>
                        <option value="present" {{#if (eq group.mode "present")}}selected{{/if}}>Enquanto presente</option>
                        <option value="equipped_manual" {{#if (eq group.mode "equipped_manual")}}selected{{/if}}>Equipado e ligado</option>
                    </select>
                    <input type="text" name="system.stateEffectGroups.{{group.id}}.exclusiveSet" value="{{group.exclusiveSet}}" placeholder="Conjunto exclusivo (opcional)" title="Grupos com o mesmo conjunto desligam-se mutuamente" />
                    <a class="delete-state-effect-group" title="Excluir grupo"><i class="fas fa-trash"></i></a>
                </div>
                <ol class="effects-line-list">
                    {{#each group.effects as |effect|}}
                    <li class="effects-line-item" data-list-name="stateEffectGroups.{{group.id}}.effects" data-effect-id="{{effect.id}}">
                        <div class="effects-line effects-line-passive">
                            <div class="effects-cell effects-identity"><img src="{{effect.img}}" class="effects-icon" /><div class="effects-name">{{effect.name}}</div></div>
                            <div class="effects-cell effects-actions"><span class="effects-controls"><a class="view-original-effect" data-uuid="{{effect.uuid}}" title="Ver Efeito Original"><i class="fas fa-eye"></i></a><a class="delete-effect" title="Remover Efeito"><i class="fas fa-trash"></i></a></span></div>
                        </div>
                    </li>
                    {{else}}<li class="effects-empty">Nenhum efeito neste grupo.</li>{{/each}}
                </ol>
                <a class="effects-add-button add-effect" data-target-list="stateEffectGroups.{{group.id}}.effects"><i class="fas fa-plus"></i> Adicionar efeito</a>
            </section>
            {{else}}<p class="effects-empty">Nenhum grupo configurado.</p>{{/each}}
        </div>

        {{!-- ================================================== --}}
        {{!-- EVENTO DE USO --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">Evento de Uso</h4>
            <a class="effects-add-button add-effect" data-target-list="useEventEffects" title="Adicionar Efeito de Evento de Uso"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.useEvent as |effect|}}
                <li class="effects-line-item" data-list-name="useEventEffects" data-effect-id="{{effect.id}}">
                <div class="effects-line effects-line-passive-use">
                    <div class="effects-cell effects-identity">
                    <img src="{{effect.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{effect.name}}</div>
                    </div>
                    </div>

                    <div class="effects-cell is-center">
                    <div class="effects-label">Disparo</div>
                    <select class="effects-mini-input" name="system.useEventEffects.{{effect.id}}.useEventTrigger">
                        <option value="consume" {{#if (eq effect.useEventTrigger "consume")}}selected{{/if}}>Ao Consumir</option>
                        <option value="activate" {{#if (eq effect.useEventTrigger "activate")}}selected{{/if}}>Ao Ativar</option>
                    </select>
                    </div>

                    <div class="effects-cell is-center">
                    <div class="effects-label">Alvo</div>
                    <select class="effects-mini-input" name="system.useEventEffects.{{effect.id}}.recipient">
                        <option value="self" {{#if (eq effect.recipient "self")}}selected{{/if}}>Usuário</option>
                        <option value="target" {{#if (eq effect.recipient "target")}}selected{{/if}}>Alvo</option>
                    </select>
                    </div>

                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-effect" title="Ver Efeito Original" data-uuid="{{effect.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="Remover Efeito"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">Nenhum efeito.</li>
            {{/each}}
            </ol>
        </div>

        {{!-- ================================================== --}}
        {{!-- CONDIÇÕES GERAIS --}}
        {{!-- ================================================== --}}
        <div class="effects-block">
            <div class="effects-block-header">
            <h4 class="effects-block-title">Condições Gerais</h4>
            <a class="effects-add-button add-general-condition" title="Anexar Condição"><i class="fas fa-plus"></i></a>
            </div>

            <ol class="effects-line-list">
            {{#each system.preparedEffects.general as |condition|}}
                <li class="effects-line-item" data-list-name="generalConditions" data-effect-id="{{condition.id}}">
                <div class="effects-line effects-line-passive">
                    <div class="effects-cell effects-identity">
                    <img src="{{condition.img}}" class="effects-icon" />
                    <div class="effects-text">
                        <div class="effects-name">{{condition.name}}</div>
                    </div>
                    </div>

                    <div class="effects-cell effects-actions">
                    <span class="effects-controls">
                        <a class="view-original-condition" title="Ver Condição Original" data-uuid="{{condition.uuid}}"><i class="fas fa-eye"></i></a>
                        <a class="delete-effect" title="Remover Condição"><i class="fas fa-trash"></i></a>
                    </span>
                    </div>
                </div>
                </li>
            {{else}}
                <li class="effects-empty">Nenhuma condição.</li>
            {{/each}}
            </ol>
        </div>

        </div>
    </div>
{{/inline}}

{{!-- ============================================= --}}
{{!-- INÍCIO DA ESTRUTURA DAS FICHAS                --}}
{{!-- ============================================= --}}
<form class="{{cssClass}} gum-item-sheet effect-sheet" autocomplete="off">

{{!-- Cabeçalho da Ficha --}}
<header class="sheet-header">
  <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
  <div class="header-info">
    <div class="header-main-line">
      <textarea name="name" rows="1" placeholder="Nome do Item">{{item.name}}</textarea>
    </div>
    <div class="header-subline">
      <span class="item-type-tag">{{lookup (object 
        melee_weapon="Arma C.C." ranged_weapon="Arma L.D." 
        equipment="Equipamento" skill="Perícia" spell="Magia" 
        advantage="Vantagem" disadvantage="Desvantagem" power="Poder" modifier="Modificador" eqp_modifier="Mod. Equip." gm_modifier="GM MOD") item.type}}</span>
    </div>
    <span class="header-divider" aria-hidden="true"></span>
  </div>
</header>

{{!-- NOVA ESTRUTURA COM ABAS --}}
<section class="sheet-content">

  {{!-- 1. Navegação das Abas (CORRIGIDA) --}}
  <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item" data-tab="description">Descrição</a>
        {{#unless (eq item.type "eqp_modifier")}}<a class="item" data-tab="details">Detalhes</a>{{/unless}}
        {{#if (eq item.type "eqp_modifier")}}
        <a class="item" data-tab="adjustments">Ajustes</a>
        <a class="item" data-tab="equipment-features">Features</a>
        {{/if}}
        {{#if (or (eq item.type "advantage") (eq item.type "disadvantage"))}}
        <a class="item" data-tab="social">{{localize "GUM.Social.Tab"}}</a>
        {{/if}}

        {{#if (eq item.type "spell")}}
        <a class="item" data-tab="casting">Conjuração</a>
        {{/if}}
        {{#if (eq item.type "power")}}
        <a class="item" data-tab="activation">Ativação</a>
        {{/if}}
       
        {{!-- Bloco 2: Aba "Modos de Ataque" para Equipamentos --}}
        {{#if (eq item.type "equipment")}}
        <a class="item" data-tab="attacks">Modos de Ataque</a>
        {{/if}}

        {{!-- Bloco 2.1: Aba "Proteção" para Equipamentos --}}
        {{#if (eq item.type "equipment")}}
        <a class="item" data-tab="protection">Proteção</a>
        {{/if}}
        
        {{!-- Bloco 3: Aba "Efeitos" (lógica original) --}}
        {{#if (or (eq item.type "skill") (eq item.type "spell") (eq item.type "power") (eq item.type "equipment") (eq item.type "advantage") (eq item.type "disadvantage"))}}
        <a class="item" data-tab="effects">Efeitos</a>
        {{/if}}
        
        {{!-- Bloco 4: Aba "Modificadores" (lógica original) --}}
        {{#if (or (eq item.type "advantage") (eq item.type "disadvantage") (eq item.type "power"))}}
        <a class="item" data-tab="modifiers">Modificadores</a>
        {{/if}}
 

        {{!-- Aba Pré-definido para Perícias --}}
        {{#if (eq item.type "skill")}}
        <a class="item" data-tab="predefined">Pré-definido</a>
        {{/if}}

        {{!-- Aba Mods para Equipamentos e Armaduras --}}
        {{#if (eq item.type "equipment")}}
        <a class="item" data-tab="eqp_modifiers">Mods</a>
        {{/if}}
  </nav>

    {{!-- 2. Corpo das Abas --}}
<section class="sheet-body-content">

     {{#if (or (eq item.type "advantage") (eq item.type "disadvantage"))}}
     <div class="tab item-social-tab" data-tab="social">
       <div class="item-social-toolbar">
         <div class="item-social-toolbar-copy"><span class="item-social-toolbar-icon"><i class="fas fa-users"></i></span><div><h4>{{localize "GUM.Social.Tab"}}</h4><p>{{localize "GUM.Social.ItemHint"}}</p></div></div>
         <button type="button" class="add-item-social"><i class="fas fa-plus"></i> {{localize "GUM.Social.AddContribution"}}</button>
       </div>
       <div class="item-social-list">
       {{#each socialContributions}}
       <details class="item-social-contribution" data-id="{{id}}" {{#if open}}open{{/if}}>
         <summary class="item-social-contribution-header">
           <span class="item-social-number"><i class="{{icon}}"></i></span>
           <span class="item-social-heading"><strong>{{typeLabel}}</strong><small>{{localize "GUM.Social.ItemContribution"}}</small></span>
           <i class="fas fa-chevron-up item-social-chevron" aria-hidden="true"></i>
         </summary>
         <button type="button" class="delete-item-social item-social-delete" data-id="{{id}}" title="{{localize 'GUM.Social.Delete'}}" aria-label="{{localize 'GUM.Social.Delete'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
         <div class="item-social-contribution-body">
           <div class="item-social-field-row item-social-common-row">
             <label class="item-social-field-card item-social-type-field"><span class="item-social-field-label">{{localize "GUM.Social.Type"}}</span><span class="item-social-field-control"><select class="item-social-type">{{selectOptions ../socialCategories selected=type valueAttr="type" labelAttr="label"}}</select></span></label>
             <label class="item-social-field-card item-social-points-field"><span class="item-social-field-label">{{localize "GUM.Social.Fields.Points"}}</span><span class="item-social-field-control"><input type="number" name="system.social_contributions.{{id}}.points" value="{{points}}"></span></label>
           </div>
           <div class="item-social-fields">
           {{#each fieldRows}}
             <div class="item-social-field-row">
             {{#each fields}}
               <label class="item-social-field-card {{#if compact}}is-compact{{/if}} {{#if wide}}is-wide{{/if}}"><span class="item-social-field-label">{{label}}</span><span class="item-social-field-control">
               {{#if (eq type "textarea")}}<textarea name="system.social_contributions.{{../../id}}.{{name}}">{{value}}</textarea>{{else}}<input type="{{type}}" name="system.social_contributions.{{../../id}}.{{name}}" value="{{value}}">{{/if}}</span>
               </label>
             {{/each}}
             </div>
           {{/each}}
           </div>
         </div>
       </details>
       {{/each}}
       </div>
     </div>
     {{/if}}

     {{!-- Aba "Detalhes" --}}
     <div class="tab" data-tab="details">
        
        {{!-- ===================================================================== --}}
        {{!-- 		ABA DETALHES: ITEM EQUIPAMENTO 				 --}}
        {{!-- ===================================================================== --}}
        {{#if (eq item.type "equipment")}}
            {{> itemDetailsGeneral}}
        {{/if}}
        
{{!-- ===================================================================== --}}
{{!--       ABA DETALHES: MODIFICADOR DO MESTRE (FORMULÁRIO TÉCNICO)      --}}
{{!-- ===================================================================== --}}
{{#if (eq item.type "gm_modifier")}}

        <div class="form-section gm-modifier-config-workspace effect-premium-workspace">
            <div class="effect-premium-toolbar">
                <div class="effect-premium-toolbar-title">
                    <div class="effect-premium-toolbar-icon" aria-hidden="true">
                        <i class="fas fa-sliders-h"></i>
                    </div>
                    <div class="effect-premium-toolbar-copy">
                        <h4>Configuração do Modificador</h4>
                        <span class="effect-premium-toolbar-subtitle">Organização e apresentação para o mestre</span>
                    </div>
                </div>
            </div>
         <div class="gm-modifier-config-grid">
                <div class="effect-premium-field">
                    <label class="effect-premium-field-label">
                        <a class="open-reference-link" title="Abrir Referência"><i class="fas fa-book-open" aria-hidden="true"></i></a>
                        Referência / Página
                    </label>
                    <div class="effect-premium-field-control">
                        <input type="text" name="system.ref" value="{{system.ref}}" placeholder="Ex: B345"/>
                    </div>
                </div>

                <div class="effect-premium-field">
                    <label class="effect-premium-field-label">
                        <i class="fas fa-folder-open" aria-hidden="true"></i>
                        Categoria principal
                    </label>
                    <div class="effect-premium-field-control">
                        <select name="system.ui_category">
                            {{#each gmModifierCategoryOptions as |category|}}
                                <option value="{{category.id}}" {{#if (or (eq ../system.ui_category category.id) (and (eq category.id "situation") (not ../system.ui_category)))}}selected{{/if}}>{{category.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
<div class="effect-premium-field">
                    <label class="effect-premium-field-label">
                        <i class="fas fa-layer-group" aria-hidden="true"></i>
                        Grupo de exibição
                    </label>
                    <div class="effect-premium-field-control">
                        <input type="text" name="system.group" value="{{system.group}}" placeholder="Opcional; vazio usa a categoria"/>
                    </div>
                </div>
                
                <div class="effect-premium-field">
                    <label class="effect-premium-field-label">
                        <i class="fas fa-hourglass-half" aria-hidden="true"></i>
                        Duração / Escopo
                    </label>
                    <div class="effect-premium-field-control">
                        <input type="text" name="system.duration" value="{{system.duration}}" placeholder="Ex: próxima rolagem, cena, enquanto mirar"/>
                    </div>
                </div>
                <div class="effect-premium-field gm-modifier-observation-field">
                    <label class="effect-premium-field-label">
                        <i class="fas fa-sticky-note" aria-hidden="true"></i>
                        Observação
                    </label>
                    <div class="effect-premium-field-control">
                        <input type="text" name="system.observation" value="{{system.observation}}" placeholder="Nota curta para uso pelo mestre"/>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section skill-details-compact gm-modifier-details-form gm-modifier-roll-workspace effect-premium-workspace">
            <div class="effect-premium-toolbar modifier-entry-toolbar">
                <div class="effect-premium-toolbar-title">
                    <div class="effect-premium-toolbar-copy">
                        <h4>Entradas de Modificador</h4>
                        <span class="effect-premium-toolbar-subtitle">
                            Adicione uma linha para cada bônus/penalidade deste efeito.
                        </span>
                    </div>
                </div>

                <button type="button" class="add-gm-mod-entry effect-premium-add-action">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                    Adicionar Entrada
                </button>
            </div>
            <datalist id="gm-mod-context-options">
                {{#each gmRollContextOptions as |ctx|}}
                    <option value="{{ctx.id}}">{{ctx.label}}</option>
                {{/each}}
            </datalist>

            <div class="effect-premium-roll-compact">
                {{#each gmModifierEntries as |entry|}}
                    <div class="effect-premium-roll-flat-entry modifier-entry-row gm-mod-entry" data-entry-index="{{entry.index}}">
                        <div class="effect-premium-roll-extra-header">
                            <div>
                                <span class="effect-premium-roll-extra-title">
                                    Entrada {{entry.displayIndex}}
                                </span>

                                <span class="effect-premium-roll-extra-meta">
                                    Modificador manual do mestre
                                </span>
                            </div>

                            <button type="button" class="remove-gm-mod-entry effect-premium-icon-button" data-index="{{entry.index}}" title="Remover entrada" aria-label="Remover entrada {{entry.displayIndex}}">
                                <i class="fas fa-trash" aria-hidden="true"></i>
                            </button>
                        </div>

                        <div class="effect-premium-grid effect-premium-grid-entry-primary">
                            <div class="effect-premium-field modifier-entry-field">
                                <label class="effect-premium-field-label">
                                    <i class="fas fa-tag" aria-hidden="true"></i>
                                    TEXTO NA JANELA DE ROLAGEM
                                </label>
                                <div class="effect-premium-field-control">
                                    <input type="text" name="system.modifier_entries.{{entry.index}}.label" value="{{entry.label}}" placeholder="Ex: Bônus de ataque"/>
                                </div>
                            </div>

                            <div class="effect-premium-field modifier-entry-field modifier-entry-field-value">
                                <label class="effect-premium-field-label">
                                    <i class="fas fa-plus" aria-hidden="true"></i>
                                    Valor
                                </label>
                                <div class="effect-premium-field-control">
                                    <input type="number" name="system.modifier_entries.{{entry.index}}.value" value="{{entry.value}}"/>
                                </div>
                            </div>

                            <div class="effect-premium-field modifier-entry-field modifier-entry-field-cap">
                                <label class="effect-premium-field-label">
                                    <i class="fas fa-tachometer-alt" aria-hidden="true"></i>
                                    Cap NH (teto)
                                </label>
                                <div class="effect-premium-field-control">
                                    <input type="text" name="system.modifier_entries.{{entry.index}}.nh_cap" value="{{entry.nh_cap}}" placeholder="Opcional"/>
                                </div>
                            </div>
                        </div>

                        <div class="effect-premium-grid effect-premium-grid-entry-context">
                            <div class="effect-premium-field modifier-entry-field modifier-entry-field-context">
                                <label class="effect-premium-field-label">
                                    <i class="fas fa-crosshairs" aria-hidden="true"></i>
                                    Contextos (CSV)
                                </label>
                                <div class="effect-premium-field-control">
                                    <div class="modifier-entry-label-line">
                                        <input type="text" class="context-csv-input" list="gm-mod-context-options" name="system.modifier_entries.{{entry.index}}.contexts" value="{{entry.contexts}}" placeholder="Ex: attack_melee,defense_parry"/>
                                        <button type="button" class="open-context-picker effect-premium-icon-button" data-target-input="system.modifier_entries.{{entry.index}}.contexts" title="Selecionar contextos" aria-label="Selecionar contextos">
                                            <i class="fas fa-search" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <p class="effect-premium-field-hint">Separe múltiplos contextos por vírgula.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>

{{/if}}
                {{!-- ===================================================================== --}}
        {{!--           ABA DETALHES: ITEM VANTAGENS E DESVANTAGENS              --}}
        {{!-- ===================================================================== --}}
                {{#if (or (eq item.type "advantage") (eq item.type "disadvantage"))}}
          <div class="skill-details-dashboard spell-power-dashboard characteristic-details-dashboard">
            <div class="characteristic-top-grid">
              <label class="skill-dashboard-toggle-card characteristic-favorite-card">
                <span class="skill-dashboard-toggle-icon"><i class="fas fa-star" aria-hidden="true"></i></span>
                <span class="skill-dashboard-toggle-label">Favorito</span>
                <input type="checkbox" name="system.favorite_in_combat" {{checked system.favorite_in_combat}}/>
              </label>
              <div class="skill-dashboard-card skill-dashboard-field-card characteristic-organization-card">
                <label class="skill-dashboard-card-heading"><i class="fas fa-layer-group" aria-hidden="true"></i><span>Organização na Ficha</span></label>
                <div class="skill-dashboard-card-control"><input type="text" name="system.group" value="{{system.group}}" placeholder="Ex: Racial: Elfo, Poderes Psíquicos..."/></div>
                <small class="characteristic-card-hint">O nome pode ser transformado em um grupo na ficha do personagem.</small>
              </div>
            </div>

            <div class="skill-dashboard-section characteristic-dashboard-section characteristic-cost-section" data-trait-cost-editor>
              <h4 class="skill-dashboard-section-title"><i class="fas fa-calculator" aria-hidden="true"></i> Cálculo de Custo</h4>

              <div class="characteristic-cost-options" aria-label="Opções de cálculo">
                <label class="skill-dashboard-toggle-card characteristic-cost-toggle">
                  <span class="skill-dashboard-toggle-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></span>
                  <span class="skill-dashboard-toggle-label">Possui custo por nível</span>
                  <input class="trait-cost-can-level" type="checkbox" name="system.can_level" {{checked system.can_level}}/>
                </label>
                <label class="skill-dashboard-toggle-card characteristic-cost-toggle">
                  <span class="skill-dashboard-toggle-icon"><i class="fas fa-arrow-down" aria-hidden="true"></i></span>
                  <span class="skill-dashboard-toggle-label">Arredondar para baixo</span>
                  <input type="checkbox" name="system.round_down" {{checked system.round_down}}/>
                </label>
                <label class="skill-dashboard-toggle-card characteristic-cost-toggle" title="Calcula ampliações e limitações percentuais pelo método multiplicativo opcional.">
                  <span class="skill-dashboard-toggle-icon"><i class="fas fa-percent" aria-hidden="true"></i></span>
                  <span class="skill-dashboard-toggle-label">Modificadores multiplicativos <i class="fas fa-circle-info characteristic-cost-info" aria-hidden="true"></i></span>
                  <input type="checkbox" name="system.multiplicative_modifiers" {{checked system.multiplicative_modifiers}}/>
                </label>
              </div>

              <div class="characteristic-cost-grid">
                <div class="skill-dashboard-card skill-dashboard-stat-card">
                  <label class="skill-dashboard-card-heading"><i class="fas fa-coins" aria-hidden="true"></i><span>Pontos Base</span></label>
                  <div class="skill-dashboard-card-control"><input type="number" step="any" name="system.points" value="{{system.points}}"/></div>
                </div>
                <div class="skill-dashboard-card skill-dashboard-stat-card trait-cost-level-card">
                  <label class="skill-dashboard-card-heading"><i class="fas fa-coins" aria-hidden="true"></i><span>Pontos por Nível</span></label>
                  <div class="skill-dashboard-card-control"><input class="trait-cost-level-dependent" type="number" step="any" name="system.points_per_level" value="{{system.points_per_level}}"/></div>
                </div>
                <div class="skill-dashboard-card skill-dashboard-stat-card trait-cost-level-card">
                  <label class="skill-dashboard-card-heading"><i class="fas fa-sort-numeric-up" aria-hidden="true"></i><span>Nível</span></label>
                  <div class="skill-dashboard-card-control"><input class="trait-cost-level-dependent" type="number" step="any" min="0" name="system.level" value="{{system.level}}"/></div>
                </div>
                <div class="skill-dashboard-card skill-dashboard-stat-card">
                  <label class="skill-dashboard-card-heading"><i class="fas fa-xmark" aria-hidden="true"></i><span>Multiplicador Final</span></label>
                  <div class="skill-dashboard-card-control"><input type="number" step="any" min="0" name="system.cost_multiplier" value="{{system.cost_multiplier}}"/></div>
                </div>
              </div>

              <div class="skill-dashboard-card characteristic-cost-result-card">
                <div class="characteristic-cost-result-heading">
                  <i class="fas fa-receipt" aria-hidden="true"></i>
                  <span>Custo Final</span>
                </div>
                <div class="calculated-cost value characteristic-cost-result">
                  <span>{{calculatedCost.finalPoints}}</span>
                  <small>{{calculatedCost.description}}</small>
                </div>
              </div>
            </div>

            <div class="skill-dashboard-section characteristic-dashboard-section">
              <h4 class="skill-dashboard-section-title"><i class="fas fa-cogs" aria-hidden="true"></i> Mecânica e Contexto</h4>
              <div class="spell-power-result-grid characteristic-context-grid">
