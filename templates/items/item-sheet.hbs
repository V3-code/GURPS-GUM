                        <div class="skill-dashboard-card-control skill-dashboard-stacked-control">
                            <select name="system.base_attribute_select" class="skill-base-attribute-select power-base-attribute-select" data-custom-target=".power-base-attribute-custom">
                                <option value="st" {{#if (eq powerBaseAttributeSelect "st")}}selected{{/if}}>ST</option><option value="dx" {{#if (eq powerBaseAttributeSelect "dx")}}selected{{/if}}>DX</option><option value="iq" {{#if (eq powerBaseAttributeSelect "iq")}}selected{{/if}}>IQ</option><option value="ht" {{#if (eq powerBaseAttributeSelect "ht")}}selected{{/if}}>HT</option><option value="per" {{#if (eq powerBaseAttributeSelect "per")}}selected{{/if}}>Per</option><option value="vont" {{#if (or (eq powerBaseAttributeSelect "vont") (eq powerBaseAttributeSelect "will"))}}selected{{/if}}>Vont</option><option value="skill" {{#if (eq powerBaseAttributeSelect "skill")}}selected{{/if}}>Perícia</option><option value="spell" {{#if (eq powerBaseAttributeSelect "spell")}}selected{{/if}}>Magia</option><option value="power" {{#if (eq powerBaseAttributeSelect "power")}}selected{{/if}}>Poder</option><option value="custom" {{#if (eq powerBaseAttributeSelect "custom")}}selected{{/if}}>Valor/Expressão</option>
                            </select>
                            <input class="skill-base-attribute-custom power-base-attribute-custom" type="text" name="system.base_attribute_custom" value="{{powerBaseAttributeCustom}}" placeholder="{{powerBaseAttributePlaceholder}}" {{#unless powerBaseAttributeCustomEnabled}}disabled{{/unless}}/>
                        </div>
                    </div>
                    <div class="skill-dashboard-card skill-dashboard-field-card">
                        <label class="skill-dashboard-card-heading"><i class="fas fa-shield-alt" aria-hidden="true"></i><span>Dificuldade</span></label>
                        <div class="skill-dashboard-card-control skill-dashboard-stacked-control"><select name="system.difficulty" class="power-difficulty-select">{{selectOptions powerDifficultyOptions selected=powerDifficultySelected}}</select><input class="power-linear-points" type="number" step="1" min="0" name="system.cost_per_level" value="{{system.cost_per_level}}" placeholder="pts/nível" {{#unless powerUsesLinearCost}}disabled{{/unless}}/></div>
                    </div>
                </div>
                <div class="spell-power-result-grid">
                    <div class="skill-dashboard-card skill-dashboard-stat-card"><label class="skill-dashboard-card-heading"><i class="fas fa-balance-scale" aria-hidden="true"></i><span>Nível Relativo</span></label><div class="skill-dashboard-card-control skill-dashboard-stepper counter-wrapper"><a class="adjust-value" data-action="decrease" data-target="system.skill_level"><i class="fas fa-minus" aria-hidden="true"></i></a><input type="number" name="system.skill_level" value="{{system.skill_level}}" data-dtype="Number"><a class="adjust-value" data-action="increase" data-target="system.skill_level"><i class="fas fa-plus" aria-hidden="true"></i></a></div></div>
                    <div class="skill-dashboard-card skill-dashboard-stat-card"><label class="skill-dashboard-card-heading"><i class="fas fa-calculator" aria-hidden="true"></i><span>Modificador Base</span></label><div class="skill-dashboard-card-control"><input type="number" name="system.nh_mod" value="{{system.nh_mod}}" placeholder="+0"/></div></div>
                    <div class="skill-dashboard-card skill-dashboard-stat-card"><label class="skill-dashboard-card-heading"><i class="fas fa-gem" aria-hidden="true"></i><span>Pontos da Habilidade</span></label><div class="skill-dashboard-card-control"><input type="number" name="system.points_skill" value="{{system.points_skill}}" {{#if (ne system.auto_points false)}}disabled{{/if}}/></div></div>
                </div>
            </div>

            <div class="skill-dashboard-section power-dashboard-section">
                <h4 class="skill-dashboard-section-title"><i class="fas fa-crosshairs" aria-hidden="true"></i> Ataque Após Ativação</h4>
                <div class="spell-power-result-grid spell-power-attack-grid">
                    <label class="skill-dashboard-toggle-card spell-power-inline-toggle"><span class="skill-dashboard-toggle-icon"><i class="fas fa-dice-d20" aria-hidden="true"></i></span><span class="skill-dashboard-toggle-label">Exige rolagem de ataque</span><input type="checkbox" name="system.uses_attack" class="power-uses-attack-toggle" {{checked system.uses_attack}}/></label>
                    <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-location-arrow" aria-hidden="true"></i><span>Tipo de Ataque</span></label><div class="skill-dashboard-card-control"><select name="system.attack_type" class="spell-power-attack-type" {{#unless system.uses_attack}}disabled{{/unless}}><option value="melee" {{#if (eq system.attack_type "melee")}}selected{{/if}}>Corpo a corpo</option><option value="ranged" {{#if (eq system.attack_type "ranged")}}selected{{/if}}>À distância</option></select></div></div>
                    <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-link" aria-hidden="true"></i><span>Perícia de Ataque</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.skill_name" value="{{system.attack_roll.skill_name}}" placeholder="Ex: Ataque Inato (Projétil), DX, 14" {{#unless system.uses_attack}}disabled{{/unless}}/></div></div>
                    <div class="skill-dashboard-card skill-dashboard-stat-card"><label class="skill-dashboard-card-heading"><i class="fas fa-calculator" aria-hidden="true"></i><span>Modificador Base de Ataque</span></label><div class="skill-dashboard-card-control"><input type="number" name="system.attack_roll.skill_level_mod" value="{{system.attack_roll.skill_level_mod}}" {{#unless system.uses_attack}}disabled{{/unless}}/></div></div>
                    <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-dumbbell" aria-hidden="true"></i><span>ST Mínima</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.min_strength" value="{{attackMinStrength}}" placeholder="Ex: 10" {{#unless system.uses_attack}}disabled{{/unless}}/></div></div>
                    <div class="spell-power-attack-type-fields {{#unless (eq system.attack_type "melee")}}is-hidden{{/unless}}" data-attack-fields="melee">
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-ruler-horizontal" aria-hidden="true"></i><span>Alcance</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.reach" value="{{system.attack_roll.reach}}" placeholder="Ex: C, 1, C-2"/></div></div>
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-shield-alt" aria-hidden="true"></i><span>Aparar</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.parry" value="{{system.attack_roll.parry}}" placeholder="Ex: 0, -1, Não"/></div></div>
                    </div>
                    <div class="spell-power-attack-type-fields {{#unless (eq system.attack_type "ranged")}}is-hidden{{/unless}}" data-attack-fields="ranged">
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-crosshairs" aria-hidden="true"></i><span>Precisão</span></label><div class="skill-dashboard-card-control"><input type="number" name="system.attack_roll.accuracy" value="{{system.attack_roll.accuracy}}" placeholder="Ex: 3"/></div></div>
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-ruler-horizontal" aria-hidden="true"></i><span>Alcance</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.range" value="{{system.attack_roll.range}}" placeholder="Ex: 100/200"/></div></div>
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-burst" aria-hidden="true"></i><span>CdT</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.rof" value="{{system.attack_roll.rof}}" placeholder="Ex: 1, 3, 10x9"/></div></div>
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-layer-group" aria-hidden="true"></i><span>Tiros</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.shots" value="{{system.attack_roll.shots}}" placeholder="Ex: 10(3)"/></div></div>
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-weight-hanging" aria-hidden="true"></i><span>Magn.</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.attack_roll.bulk" value="{{system.attack_roll.bulk}}" placeholder="Ex: -4"/></div></div>
                        <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-arrows-left-right" aria-hidden="true"></i><span>RCO</span></label><div class="skill-dashboard-card-control"><input type="number" name="system.attack_roll.rcl" value="{{system.attack_roll.rcl}}" placeholder="Ex: 2"/></div></div>
                    </div>
                </div>
            </div>

            <div class="skill-dashboard-section power-dashboard-section spell-power-damage-section">
                <h4 class="skill-dashboard-section-title"><i class="fas fa-burst" aria-hidden="true"></i> Dano</h4>
                <div class="item-damage-table spell-power-dashboard-damage">
                    <div class="damage-table-spacer"></div><div class="damage-col-label">Fórmula</div><div class="damage-col-label">Tipo</div><div class="damage-col-label">Natureza</div><div class="damage-col-label">Div.</div><div class="damage-col-label">Escala</div>
                    <label class="effect-label">Dano Primário</label><input type="text" name="system.damage.formula" value="{{system.damage.formula}}" placeholder="Ex: 3d6, 1d6-1"/><input type="text" name="system.damage.type" value="{{system.damage.type}}" placeholder="Ex: qmd, cont, cort"/><input type="text" name="system.damage.nature" value="{{system.damage.nature}}" placeholder="Ex: Fogo [FOG]"/><input type="number" step="0.1" name="system.damage.armor_divisor" value="{{system.damage.armor_divisor}}" title="Divisor de Armadura"/><input type="text" name="system.damage.scaling" value="{{system.damage.scaling}}" placeholder="Ex: +1d6/point" title="Progressão de dano importada/editável. Ex: +1d6/point"/>
                    <label class="effect-label">Dano de Acompanhamento</label><input type="text" name="system.damage.follow_up_damage.formula" value="{{system.damage.follow_up_damage.formula}}"/><input type="text" name="system.damage.follow_up_damage.type" value="{{system.damage.follow_up_damage.type}}"/><input type="text" name="system.damage.follow_up_damage.nature" value="{{system.damage.follow_up_damage.nature}}" placeholder="Natureza"/><input type="number" step="0.1" name="system.damage.follow_up_damage.armor_divisor" value="{{system.damage.follow_up_damage.armor_divisor}}" title="Divisor"/><input type="text" name="system.damage.follow_up_damage.scaling" value="{{system.damage.follow_up_damage.scaling}}" placeholder="Ex: +1d6/point" title="Progressão de dano importada/editável. Ex: +1d6/point"/>
                    <label class="effect-label">Dano de Fragmentação</label><input type="text" name="system.damage.fragmentation_damage.formula" value="{{system.damage.fragmentation_damage.formula}}"/><input type="text" name="system.damage.fragmentation_damage.type" value="{{system.damage.fragmentation_damage.type}}"/><input type="text" name="system.damage.fragmentation_damage.nature" value="{{system.damage.fragmentation_damage.nature}}" placeholder="Natureza"/><input type="number" step="0.1" name="system.damage.fragmentation_damage.armor_divisor" value="{{system.damage.fragmentation_damage.armor_divisor}}" title="Divisor"/><input type="text" name="system.damage.fragmentation_damage.scaling" value="{{system.damage.fragmentation_damage.scaling}}" placeholder="Ex: +1d6/point" title="Progressão de dano importada/editável. Ex: +1d6/point"/>
                </div>
            </div>

            <div class="skill-dashboard-section power-dashboard-section">
                <h4 class="skill-dashboard-section-title"><i class="fas fa-clipboard-check" aria-hidden="true"></i> Resultado</h4>
                <div class="spell-power-result-grid spell-power-two-grid">
                    <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-shield-alt" aria-hidden="true"></i><span>Resistido Por</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.resistance" value="{{system.resistance}}" placeholder="Ex: HT, Vontade, IQ-3"/></div></div>
                    <div class="skill-dashboard-card skill-dashboard-field-card"><label class="skill-dashboard-card-heading"><i class="fas fa-scroll" aria-hidden="true"></i><span>Resumo do Efeito</span></label><div class="skill-dashboard-card-control"><input type="text" name="system.effect" value="{{system.effect}}" placeholder="Resumo curto para consulta"/></div></div>
                </div>
            </div>
        </div>
        {{/if}}
     </div>

{{! ========================================================= }}
    {{!  ABA "DESCRIÇÃO" (COM O EDITOR CORRETO)     }}
    {{! ========================================================= }}
    {{!-- Ajustes e organização do modificador de equipamento --}}
    <div class="tab" data-tab="adjustments">
      {{#if (eq item.type "eqp_modifier")}}
      <div class="eqp-modifier-workspace eqp-adjustments-workspace">
        <section class="eqp-modifier-catalog">
          <div class="eqp-modifier-section-heading"><i class="fas fa-folder-open" aria-hidden="true"></i><div><h4>Organização e cenário</h4></div><i class="fas fa-circle-info eqp-heading-help" title="Informações de catálogo usadas para encontrar e contextualizar este modificador." aria-label="Informações sobre organização e cenário"></i></div>
          <div class="eqp-modifier-catalog-grid">
            <label class="eqp-modifier-catalog-field eqp-field-card is-group"><span>Grupo</span><input type="text" name="system.group" value="{{system.group}}" placeholder="Ex.: Materiais, Encantamentos, Qualidade"/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-compact"><span>NT</span><input type="text" name="system.tech_level" value="{{system.tech_level}}" placeholder="Ex.: 3, 8^"/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-compact"><span>Nível</span><input type="number" min="0" step="1" name="system.level" value="{{system.level}}"/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-compact"><span>Pontos</span><input type="number" step="1" name="system.points" value="{{system.points}}" title="Valor de pontos de catálogo. Ainda não participa de nenhum cálculo automático."/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-half"><span>Raridade</span><input type="text" name="system.scenario.rarity" value="{{system.scenario.rarity}}" placeholder="Ex.: Comum, Único"/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-half"><span>Disponibilidade</span><input type="text" name="system.scenario.availability" value="{{system.scenario.availability}}" placeholder="Ex.: Mercado 12-, Apenas Conexão"/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-half"><span>Região / Origem</span><input type="text" name="system.scenario.location" value="{{system.scenario.location}}" placeholder="Ex.: Forjas Reais de Khazad"/></label>
            <label class="eqp-modifier-catalog-field eqp-field-card is-half"><span>Material predominante</span><input type="text" name="system.scenario.components" value="{{system.scenario.components}}" placeholder="Ex.: Oricalco, aço meteórico"/></label>
          </div>
          <label class="custom-checkbox eqp-modifier-enabled"><input type="checkbox" name="system.enabled" {{checked system.enabled}}/><span>Habilitado por padrão</span><i class="fas fa-circle-info" title="Define se este modificador será incluído como ativo quando for adicionado a um equipamento. A ativação pode ser alterada depois no próprio equipamento." aria-label="Informações sobre habilitação padrão"></i></label>
        </section>

        <section class="eqp-adjustment-panel">
          <div class="eqp-adjustment-panel-heading"><i class="fas fa-coins" aria-hidden="true"></i><div><h4>Ajuste de preço</h4></div><i class="fas fa-circle-info eqp-heading-help" title="Configure o custo e a etapa em que o ajuste entra no cálculo." aria-label="Informações sobre ajuste de preço"></i></div>
          <div class="eqp-adjustment-primary-grid">
            <label class="eqp-adjustment-field eqp-field-card"><span>Expressão <i class="fas fa-circle-info" title="CF e multiplicadores estruturais pertencem normalmente ao valor base." aria-label="Ajuda sobre a expressão de preço"></i></span><input type="text" name="system.cost_adjustment_data.expression" value="{{eqpModifierAdjustment.cost.expression}}" placeholder="Ex.: +0,2 CF, x4, +50, -10%"/></label>
            <label class="eqp-adjustment-field eqp-field-card"><span>Aplicar ao</span><select name="system.cost_adjustment_data.stage">{{selectOptions equipmentAdjustmentStageOptions selected=eqpModifierAdjustment.cost.stage valueAttr="id" labelAttr="label"}}</select></label>
          </div>
          <div class="eqp-adjustment-options-grid">
            <label class="eqp-adjustment-option"><input type="checkbox" name="system.cost_adjustment_data.per_level" {{checked eqpModifierAdjustment.cost.perLevel}}/><span>Por nível</span></label>
            <label class="eqp-adjustment-option"><input type="checkbox" name="system.cost_adjustment_data.per_weight" {{checked eqpModifierAdjustment.cost.perWeight}}/><span>Por peso</span></label>
            <label class="eqp-adjustment-field eqp-field-card is-compact"><span>Unidade para preço por peso</span><select name="system.cost_adjustment_data.per_weight_unit" title="Usada somente quando o preço é calculado por peso."><option value="kg" {{#if (eq eqpModifierAdjustment.cost.perWeightUnit "kg")}}selected{{/if}}>kg</option><option value="lb" {{#if (eq eqpModifierAdjustment.cost.perWeightUnit "lb")}}selected{{/if}}>lb</option></select></label>
          </div>
        </section>

        <section class="eqp-adjustment-panel">
          <div class="eqp-adjustment-panel-heading"><i class="fas fa-weight-hanging" aria-hidden="true"></i><div><h4>Ajuste de peso</h4></div><i class="fas fa-circle-info eqp-heading-help" title="Controle a massa final e sua ordem na resolução." aria-label="Informações sobre ajuste de peso"></i></div>
          <div class="eqp-adjustment-primary-grid">
            <label class="eqp-adjustment-field eqp-field-card"><span>Expressão <i class="fas fa-circle-info" title="Inclua a unidade diretamente na expressão quando necessário, por exemplo: +0,5 kg ou +1 lb." aria-label="Ajuda sobre a expressão de peso"></i></span><input type="text" name="system.weight_adjustment_data.expression" value="{{eqpModifierAdjustment.weight.expression}}" placeholder="Ex.: +0,5 kg, -10%, x0,75, x2/3"/></label>
            <label class="eqp-adjustment-field eqp-field-card"><span>Aplicar ao</span><select name="system.weight_adjustment_data.stage">{{selectOptions equipmentAdjustmentStageOptions selected=eqpModifierAdjustment.weight.stage valueAttr="id" labelAttr="label"}}</select></label>
          </div>
          <div class="eqp-adjustment-options-grid is-single">
            <label class="eqp-adjustment-option"><input type="checkbox" name="system.weight_adjustment_data.per_level" {{checked eqpModifierAdjustment.weight.perLevel}}/><span>Por nível</span></label>
          </div>
        </section>

      </div>
      {{/if}}
    </div>

    <div class="tab" data-tab="equipment-features">
      {{#if (eq item.type "eqp_modifier")}}
      <div class="eqp-modifier-workspace eqp-features-workspace">
        <div class="eqp-features-toolbar">
          <span class="eqp-features-label"><i class="fas fa-puzzle-piece" aria-hidden="true"></i> Features</span>
          <button type="button" class="add-eqp-feature"><i class="fas fa-plus"></i><span>Adicionar feature</span></button>
        </div>

        <ol class="eqpmod-line-list eqp-feature-list">
        {{#each eqpModifierFeatures as |feature|}}
          <li class="eqpmod-line-item eqp-feature-card {{#unless feature.enabled}}is-disabled{{/unless}}" data-feature-id="{{feature.id}}">
            <div class="form-grid-3 eqp-feature-card-header">
              <label class="custom-checkbox eqp-feature-enabled"><input type="checkbox" name="system.features_data.{{feature.id}}.enabled" {{checked feature.enabled}}/><span>Ativa</span></label>
              <div class="form-group"><label>Nome</label><input type="text" name="system.features_data.{{feature.id}}.label" value="{{feature.label}}"/></div>
              <div class="form-group"><label>Tipo</label><select class="eqp-feature-shape-select" name="system.features_data.{{feature.id}}.type">{{selectOptions ../equipmentFeatureTypeOptions selected=feature.type valueAttr="id" labelAttr="label"}}</select></div>
            </div>

            {{#if (eq feature.type "equipment_property")}}
            <div class="form-grid-3">
              <div class="form-group"><label>Propriedade</label><select class="eqp-feature-shape-select" name="system.features_data.{{feature.id}}.path">{{selectOptions ../equipmentPropertyOptions selected=feature.path valueAttr="id" labelAttr="label"}}</select></div>
              <div class="form-group"><label>Operação</label><select name="system.features_data.{{feature.id}}.operation">{{#if feature.cumulative_text_equipment_value}}<option value="add" {{#if (eq feature.operation "add")}}selected{{/if}}>Acrescentar</option><option value="set" {{#if (eq feature.operation "set")}}selected{{/if}}>Substituir</option>{{else}}{{selectOptions ../equipmentFeatureOperationOptions selected=feature.operation valueAttr="id" labelAttr="label"}}{{/if}}</select></div>
              <div class="form-group"><label>Valor</label><input type="{{#if feature.numeric_equipment_value}}number{{else}}text{{/if}}" step="any" name="system.features_data.{{feature.id}}.value" value="{{feature.value}}"/></div>
            </div>
            {{#if feature.cumulative_text_equipment_value}}<p class="notes">“Acrescentar” mantém os valores anteriores em uma lista; “Substituir” troca o valor final. Texto não pode ser multiplicado.</p>{{/if}}
            <label class="custom-checkbox"><input type="checkbox" name="system.features_data.{{feature.id}}.per_level" {{checked feature.per_level}}/><span>Por nível do modificador</span></label>
            {{/if}}

            {{#if (eq feature.type "equipment_dr")}}
            <div class="form-grid-3">
              <div class="form-group"><label>Localização</label><select name="system.features_data.{{feature.id}}.location"><option value="all" {{#if (eq feature.location "all")}}selected{{/if}}>Todas as localizações do item</option>{{selectOptions ../equipmentBodyLocationOptions selected=feature.location valueAttr="id" labelAttr="name"}}</select></div>
              <div class="form-group"><label>Tipo de RD</label><input type="text" name="system.features_data.{{feature.id}}.damage_type" value="{{feature.damage_type}}" placeholder="base, cort, perf..."/></div>
              <div class="form-group"><label>Operação</label><select name="system.features_data.{{feature.id}}.operation">{{selectOptions ../equipmentFeatureOperationOptions selected=feature.operation valueAttr="id" labelAttr="label"}}</select></div>
            </div>
            <div class="form-grid-2">
              <div class="form-group"><label>Valor</label><input type="number" step="any" name="system.features_data.{{feature.id}}.value" value="{{feature.value}}"/></div>
              <label class="custom-checkbox"><input type="checkbox" name="system.features_data.{{feature.id}}.per_level" {{checked feature.per_level}}/><span>Por nível do modificador</span></label>
            </div>
            <p class="notes">“base” altera a RD geral. Outros tipos representam o ajuste relativo à RD base para aquele tipo de dano.</p>
            {{/if}}

            {{#if (eq feature.type "equipment_descriptor")}}
            <div class="form-grid-2">
              <div class="form-group"><label>Categoria</label><select name="system.features_data.{{feature.id}}.descriptor_kind">{{selectOptions ../equipmentDescriptorKindOptions selected=feature.descriptor_kind valueAttr="id" labelAttr="label"}}</select></div>
              <div class="form-group"><label>Descrição acrescentada</label><input type="text" name="system.features_data.{{feature.id}}.value" value="{{feature.value}}" placeholder="Ex.: cravejado de prata, acabamento élfico"/></div>
            </div>
            <p class="notes">Descritores se acumulam entre modificadores e não substituem qualidade ou material do equipamento-base.</p>
            {{/if}}

            {{#if (eq feature.type "attack_property")}}
            <div class="form-grid-3">
