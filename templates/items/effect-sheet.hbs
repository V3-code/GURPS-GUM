<form class="{{cssClass}} gum-item-sheet effect-sheet" autocomplete="off">

    {{!-- ========================================================= --}}
    {{!-- CABEÇALHO                                                  --}}
    {{!-- ========================================================= --}}
    <header class="sheet-header">
        <img
            class="profile-img"
            src="{{item.img}}"
            data-edit="img"
            title="{{item.name}}"
        />

        <div class="header-info">
            <div class="header-main-line">
                <textarea
                    name="name"
                    rows="1"
                    placeholder="Nome do Item"
                >{{item.name}}</textarea>
            </div>

            <div class="header-subline">
                <span class="item-type-tag">Efeito</span>
            </div>

            <span class="header-divider" aria-hidden="true"></span>
        </div>
    </header>

    {{!-- ========================================================= --}}
    {{!-- ABAS                                                       --}}
    {{!-- ========================================================= --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        <a class="item active" data-tab="description">Descrição</a>
        <a class="item" data-tab="configuracao">Configuração</a>
        <a class="item" data-tab="efeitos-ativos">Efeitos Ativos</a>
    </nav>

    <main class="sheet-body">
        <div class="sheet-body-content effect-sheet-body">

            {{! ===================================================== }}
            {{! ABA: EFEITOS ATIVOS                                   }}
            {{! ===================================================== }}
            <div class="tab" data-tab="efeitos-ativos" data-group="primary">
                <section class="effect-premium-workspace">

                    <div class="effect-premium-toolbar">
                        <div class="effect-premium-toolbar-title">

                            <div class="effect-premium-toolbar-copy">
                                <h4>Ações do Efeito</h4>
                                <span class="effect-premium-toolbar-subtitle">
                                    Configure os resultados aplicados por este efeito
                                </span>
                            </div>

                            <span class="effect-premium-count">
                                {{effectActionsCountLabel}}
                            </span>
                        </div>

                        <button
                            type="button"
                            class="add-effect-action effect-premium-add-action"
                        >
                            <i class="fas fa-plus" aria-hidden="true"></i>
                            Adicionar Ação
                        </button>
                    </div>

                    {{#if effectActions.length}}
                        <div class="effect-premium-action-list">

                            {{#each effectActions as |action|}}
                                <details
                                    class="effect-action-details effect-premium-action"
                                    data-action-index="{{action.index}}"
                                    {{#if action.isExpanded}}open{{/if}}
                                >
                                    <summary class="effect-premium-action-header">
                                        <span class="effect-premium-action-number">
                                            {{action.displayIndex}}
                                        </span>

                                        <div class="effect-premium-action-copy">
                                            <div class="effect-premium-action-title-row">
                                                <span class="effect-premium-action-title">
                                                    {{action.titleText}}
                                                </span>

                                                <span class="effect-premium-action-type {{action.typeClass}}">
                                                    <i class="{{action.typeIcon}}" aria-hidden="true"></i>
                                                    {{action.typeLabel}}
                                                </span>
                                            </div>

                                            <span class="effect-premium-action-meta">
                                                {{action.summaryText}}
                                            </span>
                                        </div>

                                        <div class="effect-premium-action-controls">
                                            <button
                                                type="button"
                                                class="remove-effect-action js-summary-action effect-premium-icon-button"
                                                data-index="{{action.index}}"
                                                title="Remover ação"
                                                aria-label="Remover ação {{action.displayIndex}}"
                                            >
                                                <i class="fas fa-trash" aria-hidden="true"></i>
                                            </button>

                                            <i
                                                class="fas fa-chevron-down effect-premium-chevron"
                                                aria-hidden="true"
                                            ></i>
                                        </div>
                                    </summary>

                                    <div class="effect-premium-action-body">
                                        <input type="hidden" name="system.actions.{{action.index}}.id" value="{{action.id}}" />

                                        {{!-- IDENTIFICAÇÃO DA AÇÃO --}}
                                        <div class="effect-premium-identification-grid">

                                            <div class="effect-premium-field">
                                                <label class="effect-premium-field-label">
                                                    <i class="fas fa-tag" aria-hidden="true"></i>
                                                    Nome do efeito aplicado
                                                </label>

                                                <div class="effect-premium-field-control">
                                                    <input
                                                        type="text"
                                                        name="system.actions.{{action.index}}.label"
                                                        value="{{action.label}}"
                                                         placeholder="Ex: Penalidade em ST"
                                                    />
                                                    <p class="effect-premium-field-hint">
                                                        Nome exibido na ficha do personagem.
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="effect-premium-field">
                                                <label class="effect-premium-field-label">
                                                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                                                    Tipo
                                                </label>

                                                <div class="effect-premium-field-control">
                                                    <select name="system.actions.{{action.index}}.type">
                                                        <option
                                                            value="attribute"
                                                            {{#if (eq action.type "attribute")}}selected{{/if}}
                                                        >
                                                            Modificador de Atributo
                                                        </option>

                                                        <option
                                                            value="status"
                                                            {{#if (eq action.type "status")}}selected{{/if}}
                                                        >
                                                            Status
                                                        </option>

                                                        <option
                                                            value="resource_change"
                                                            {{#if (eq action.type "resource_change")}}selected{{/if}}
                                                        >
                                                            Alteração de Recurso
                                                        </option>

                                                        <option
                                                            value="resource_create"
                                                            {{#if (eq action.type "resource_create")}}selected{{/if}}
                                                        >
                                                            Criar Recurso
                                                        </option>

                                                        <option
                                                            value="roll_modifier"
                                                            {{#if (eq action.type "roll_modifier")}}selected{{/if}}
                                                        >
                                                            Modificador de Rolagem
                                                        </option>

                                                        <option value="skill_modifier" {{#if (eq action.type "skill_modifier")}}selected{{/if}}>
                                                            Modificar Rolagem de Perícia
                                                        </option>

                                                        <option value="combat_modifier" {{#if (eq action.type "combat_modifier")}}selected{{/if}}>
                                                            Modificar Modo de Combate
                                                        </option>

                                                        <option
                                                            value="chat"
                                                            {{#if (eq action.type "chat")}}selected{{/if}}
                                                        >
                                                            Mensagem de Chat
                                                        </option>

                                                        <option
                                                            value="macro"
                                                            {{#if (eq action.type "macro")}}selected{{/if}}
                                                        >
                                                            Macro
                                                        </option>

                                                        <option
                                                            value="flag"
                                                            {{#if (eq action.type "flag")}}selected{{/if}}
                                                        >
                                                            Flag
                                                        </option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div
                                            class="
                                                effect-premium-type-panel
                                                {{#if (eq action.type "roll_modifier")}}is-complex{{/if}}
                                                {{#if (eq action.type "skill_modifier")}}is-complex{{/if}}
                                                {{#if (eq action.type "combat_modifier")}}is-complex{{/if}}
                                                {{#if (eq action.type "chat")}}is-chat{{/if}}
                                            "
                                        >
                                            {{! ============================================= }}
                                            {{! TIPO: MODIFICADOR DE ATRIBUTO                  }}
                                            {{! ============================================= }}
                                            {{#if (eq action.type "attribute")}}
                                                <div class="effect-premium-grid effect-premium-grid-attribute-main">

                                                    <div class="effect-premium-field is-primary">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-code-branch" aria-hidden="true"></i>
                                                            Caminho
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <div class="effect-path-input-row">
                                                                <input
                                                                    type="text"
                                                                    class="effect-code-input"
                                                                    name="system.actions.{{action.index}}.path"
                                                                    value="{{action.path}}"
                                                                    placeholder="Ex: system.attributes.dx.passive"
                                                                />
                                                                <button type="button" class="open-effect-path-picker effect-premium-icon-button" data-target-input="system.actions.{{action.index}}.path" data-operation-input="system.actions.{{action.index}}.operation" title="Selecionar um caminho suportado" aria-label="Selecionar caminho"><i class="fas fa-sitemap" aria-hidden="true"></i></button>
                                                            </div>
                                                            <p class="effect-premium-field-hint">Selecione um destino do sistema ou informe um caminho personalizado.</p>
                                                        </div>
                                                    </div>

                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-calculator" aria-hidden="true"></i>
                                                            Operação
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <select name="system.actions.{{action.index}}.operation">
                                                                <option
                                                                    value="ADD"
                                                                    {{#if (eq action.operation "ADD")}}selected{{/if}}
                                                                >
                                                                    ADD/SUB
                                                                </option>

                                                                <option
                                                                    value="OVERRIDE"
                                                                    {{#if (eq action.operation "OVERRIDE")}}selected{{/if}}
                                                                >
                                                                    Definir
                                                                </option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="effect-premium-grid effect-premium-grid-single">
                                                    <div class="effect-premium-field effect-premium-expression-card">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-code" aria-hidden="true"></i>
                                                              {{#if (eq action.value_mode "per_origin_level")}}Valor por nível{{else}}Valor ou expressão{{/if}}
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <input
                                                                type="text"
                                                                class="effect-code-input effect-expression-input"
                                                                name="system.actions.{{action.index}}.value"
                                                                value="{{action.value}}"
                                                                placeholder="Ex: 2, -1, 1d6+2 ou expressão"
                                                                title="Aceita valor fixo, fórmula ou rolagem de dados, conforme o interpretador do sistema."
                                                                aria-describedby="effect-attribute-value-help-{{action.index}}"
                                                            />

                                                            <p
                                                                id="effect-attribute-value-help-{{action.index}}"
                                                                class="effect-premium-field-hint"
                                                            >
                                                                Avaliado ao aplicar. Aceita fórmula, dados e condições como <code>se(possui("Item"), 2, 1)</code>, <code>nivel("Item")</code>, <code>quantidade("Item")</code>, <code>equipado("Item")</code> e <code>status("id")</code>.
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                                 <div class="effect-premium-grid effect-premium-grid-single">
                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">Escalonamento do valor</label>
                                                        <div class="effect-premium-field-control">
                                                            <select name="system.actions.{{action.index}}.value_mode">
                                                                <option value="fixed" {{#if (eq action.value_mode "fixed")}}selected{{/if}}>Valor fixo</option>
                                                                <option value="per_origin_level" {{#if (eq action.value_mode "per_origin_level")}}selected{{/if}}>Por nível do item de origem</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="effect-premium-grid effect-premium-grid-single">
                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-message" aria-hidden="true"></i>
                                                            Exibição do valor no chat
                                                        </label>
                                                        <div class="effect-premium-field-control">
                                                            <select name="system.actions.{{action.index}}.attribute_chat_visibility">
                                                                <option value="public" {{#if (eq action.attribute_chat_visibility "public")}}selected{{/if}}>Público</option>
                                                                <option value="owners" {{#if (eq action.attribute_chat_visibility "owners")}}selected{{/if}}>Privado para donos e Mestre</option>
                                                                <option value="gm" {{#if (eq action.attribute_chat_visibility "gm")}}selected{{/if}}>Somente Mestre (rolagem oculta)</option>
                                                                <option value="none" {{#if (eq action.attribute_chat_visibility "none")}}selected{{/if}}>Não mostrar</option>
                                                            </select>
                                                            <p class="effect-premium-field-hint">Define quem vê o valor calculado. Não altera a aplicação do efeito.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            {{/if}}

                                            {{! TIPO: MODIFICAR ROLAGEM DE PERÍCIA }}
                                            {{#if (eq action.type "skill_modifier")}}
                                                <div class="effect-premium-roll-compact effect-specialized-action">
                                                    <div class="effect-specialized-grid effect-specialized-grid-two">
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">Afetar</label>
                                                            <div class="effect-premium-field-control">
                                                                <select name="system.actions.{{action.index}}.skill_scope">
                                                                    <option value="all" {{#if (eq action.skill_scope "all")}}selected{{/if}}>Todas as perícias</option>
                                                                    <option value="specific" {{#if (eq action.skill_scope "specific")}}selected{{/if}}>Perícias específicas</option>
                                                                    <option value="attribute" {{#if (eq action.skill_scope "attribute")}}selected{{/if}}>Perícias baseadas em atributo</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">Aplicar em</label>
                                                            <div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_application_side">{{#each ../rollModifierApplicationOptions as |opt|}}<option value="{{opt.id}}" {{#if (eq opt.id ../modifier_application_side)}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div>
                                                        </div>
                                                    </div>

                                                    <div class="effect-specialized-grid effect-specialized-grid-three">
                                                        <div class="effect-premium-field {{#unless (eq action.skill_scope "specific")}}is-disabled{{/unless}}">
                                                            <label class="effect-premium-field-label">Perícias específicas</label>
                                                            <div class="effect-premium-field-control">
                                                                <input type="text" name="system.actions.{{action.index}}.skill_targets" value="{{action.skill_targets}}" placeholder="Furtividade, Acrobacia" {{#unless (eq action.skill_scope "specific")}}disabled{{/unless}}/>
                                                            </div>
                                                        </div>
                                                        <div class="effect-premium-field {{#unless (eq action.skill_scope "attribute")}}is-disabled{{/unless}}">
                                                            <label class="effect-premium-field-label">Atributo base</label>
                                                            <div class="effect-premium-field-control">
                                                                <select name="system.actions.{{action.index}}.skill_attribute" {{#unless (eq action.skill_scope "attribute")}}disabled{{/unless}}><option value="st" {{#if (eq action.skill_attribute "st")}}selected{{/if}}>ST</option><option value="dx" {{#if (eq action.skill_attribute "dx")}}selected{{/if}}>DX</option><option value="iq" {{#if (eq action.skill_attribute "iq")}}selected{{/if}}>IQ</option><option value="ht" {{#if (eq action.skill_attribute "ht")}}selected{{/if}}>HT</option><option value="per" {{#if (eq action.skill_attribute "per")}}selected{{/if}}>Per</option><option value="vont" {{#if (eq action.skill_attribute "vont")}}selected{{/if}}>Vont</option></select>
                                                            </div>
                                                        </div>
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">Exibição</label>
                                                            <div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_nh_display_mode"><option value="roll_only" {{#if (eq action.modifier_nh_display_mode "roll_only")}}selected{{/if}}>Apenas rolagem</option><option value="include_in_nh" {{#if (eq action.modifier_nh_display_mode "include_in_nh")}}selected{{/if}}>Incluir no NH</option></select></div>
                                                        </div>
                                                    </div>

                                                    <div class="effect-specialized-grid effect-specialized-grid-value">
                                                        <div class="effect-premium-field effect-specialized-value-field">
                                                            <label class="effect-premium-field-label"><i class="fas fa-plus"></i> Valor</label>
                                                            <div class="effect-premium-field-control"><input type="text" class="effect-code-input" name="system.actions.{{action.index}}.modifier_value" value="{{action.modifier_value}}" placeholder='Ex: 1 ou se(status("abençoado"), 2, 0)'/><p class="effect-premium-field-hint">Aceita número, fórmula, dados ou expressão condicional.</p></div>
                                                        </div>
                                                        <div class="effect-premium-field">
                                                            <label class="effect-premium-field-label">Escalonamento</label>
                                                            <div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_value_mode"><option value="fixed" {{#if (eq action.modifier_value_mode "fixed")}}selected{{/if}}>Valor fixo</option><option value="per_origin_level" {{#if (eq action.modifier_value_mode "per_origin_level")}}selected{{/if}}>Por nível do item de origem</option></select></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            {{/if}}

                                            {{! TIPO: MODIFICAR MODO DE COMBATE }}
                                            {{#if (eq action.type "combat_modifier")}}
                                                <div class="effect-premium-roll-compact effect-specialized-action">
                                                    <div class="effect-specialized-grid effect-specialized-grid-two">
                                                        <div class="effect-premium-field"><label class="effect-premium-field-label">Modos afetados</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.combat_scope"><option value="all" {{#if (eq action.combat_scope "all")}}selected{{/if}}>Todos os modos</option><option value="melee" {{#if (eq action.combat_scope "melee")}}selected{{/if}}>Corpo a corpo</option><option value="ranged" {{#if (eq action.combat_scope "ranged")}}selected{{/if}}>À distância</option><option value="specific" {{#if (eq action.combat_scope "specific")}}selected{{/if}}>Itens ou modos específicos</option></select></div></div>
                                                        <div class="effect-premium-field"><label class="effect-premium-field-label">Aplicar em</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_application_side">{{#each ../rollModifierApplicationOptions as |opt|}}<option value="{{opt.id}}" {{#if (eq opt.id ../modifier_application_side)}}selected{{/if}}>{{opt.label}}</option>{{/each}}</select></div></div>
                                                    </div>

                                                    <div class="effect-specialized-grid effect-specialized-grid-three">
                                                        <div class="effect-premium-field {{#unless (eq action.combat_scope "specific")}}is-disabled{{/unless}}"><label class="effect-premium-field-label">Item/arma</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.combat_source_item_ids" value="{{action.combat_source_item_ids}}" placeholder="Espada Longa, Item.xxxxx" {{#unless (eq action.combat_scope "specific")}}disabled{{/unless}}/></div></div>
                                                        <div class="effect-premium-field {{#unless (eq action.combat_scope "specific")}}is-disabled{{/unless}}"><label class="effect-premium-field-label">Modo de uso</label><div class="effect-premium-field-control"><input type="text" name="system.actions.{{action.index}}.combat_source_attack_ids" value="{{action.combat_source_attack_ids}}" placeholder="Corte, Estocada" {{#unless (eq action.combat_scope "specific")}}disabled{{/unless}}/></div></div>
                                                        <div class="effect-premium-field"><label class="effect-premium-field-label">Exibição</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.modifier_nh_display_mode"><option value="roll_only" {{#if (eq action.modifier_nh_display_mode "roll_only")}}selected{{/if}}>Apenas rolagem</option><option value="include_in_nh" {{#if (eq action.modifier_nh_display_mode "include_in_nh")}}selected{{/if}}>Incluir na ficha</option></select></div></div>
                                                    </div>

                                                    <div class="effect-combat-change-list">
                                                        <section class="effect-combat-change-block" title="Aceita número, fórmula, dados ou expressão do motor de condições de valor.">
                                                            <header class="effect-combat-change-header"><label class="effect-premium-checkbox"><input type="checkbox" name="system.actions.{{action.index}}.combat_attack_enabled" {{checked action.combat_attack_enabled}}/><span>NH de ataque</span></label></header>
                                                            <div class="effect-specialized-grid effect-specialized-grid-value"><div class="effect-premium-field effect-specialized-value-field"><label class="effect-premium-field-label">Valor</label><div class="effect-premium-field-control"><input type="text" class="effect-code-input" name="system.actions.{{action.index}}.combat_attack_value" value="{{action.combat_attack_value}}" placeholder='Ex: 1 ou se(status("abençoado"), 2, 0)'/></div></div><div class="effect-premium-field"><label class="effect-premium-field-label">Escalonamento</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.combat_attack_value_mode"><option value="fixed" {{#if (eq action.combat_attack_value_mode "fixed")}}selected{{/if}}>Valor fixo</option><option value="per_origin_level" {{#if (eq action.combat_attack_value_mode "per_origin_level")}}selected{{/if}}>Por nível</option></select></div></div></div>
                                                        </section>
                                                        <section class="effect-combat-change-block" title="Aceita número, fórmula, dados ou expressão do motor de condições de valor.">
                                                            <header class="effect-combat-change-header"><label class="effect-premium-checkbox"><input type="checkbox" name="system.actions.{{action.index}}.combat_parry_enabled" {{checked action.combat_parry_enabled}}/><span>Aparar</span></label></header>
                                                            <div class="effect-specialized-grid effect-specialized-grid-value"><div class="effect-premium-field effect-specialized-value-field"><label class="effect-premium-field-label">Valor</label><div class="effect-premium-field-control"><input type="text" class="effect-code-input" name="system.actions.{{action.index}}.combat_parry_value" value="{{action.combat_parry_value}}" placeholder='Ex: 1 ou se(status("abençoado"), 2, 0)'/></div></div><div class="effect-premium-field"><label class="effect-premium-field-label">Escalonamento</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.combat_parry_value_mode"><option value="fixed" {{#if (eq action.combat_parry_value_mode "fixed")}}selected{{/if}}>Valor fixo</option><option value="per_origin_level" {{#if (eq action.combat_parry_value_mode "per_origin_level")}}selected{{/if}}>Por nível</option></select></div></div></div>
                                                        </section>
                                                        <section class="effect-combat-change-block" title="Aceita número, fórmula, dados ou expressão do motor de condições de valor.">
                                                            <header class="effect-combat-change-header"><label class="effect-premium-checkbox"><input type="checkbox" name="system.actions.{{action.index}}.combat_block_enabled" {{checked action.combat_block_enabled}}/><span>Bloqueio</span></label></header>
                                                            <div class="effect-specialized-grid effect-specialized-grid-value"><div class="effect-premium-field effect-specialized-value-field"><label class="effect-premium-field-label">Valor</label><div class="effect-premium-field-control"><input type="text" class="effect-code-input" name="system.actions.{{action.index}}.combat_block_value" value="{{action.combat_block_value}}" placeholder='Ex: 1 ou se(status("abençoado"), 2, 0)'/></div></div><div class="effect-premium-field"><label class="effect-premium-field-label">Escalonamento</label><div class="effect-premium-field-control"><select name="system.actions.{{action.index}}.combat_block_value_mode"><option value="fixed" {{#if (eq action.combat_block_value_mode "fixed")}}selected{{/if}}>Valor fixo</option><option value="per_origin_level" {{#if (eq action.combat_block_value_mode "per_origin_level")}}selected{{/if}}>Por nível</option></select></div></div></div>
                                                        </section>
                                                    </div>

                                                    <div class="effect-specialized-grid effect-specialized-grid-two effect-combat-recalculation-row">
                                                        <label class="effect-premium-checkbox"><input type="checkbox" name="system.actions.{{action.index}}.combat_recalculate_parry" {{checked action.combat_recalculate_parry}}/><span>Recalcular Aparar a partir do NH modificado</span></label>
