                                                                            <label class="effect-premium-field-label">
                                                                                <i class="fas fa-archive" aria-hidden="true"></i>
                                                                                Item/grupo de origem (ID, UUID ou nome; CSV)
                                                                            </label>

                                                                            <div class="effect-premium-field-control">
                                                                                <input
                                                                                    type="text"
                                                                                    name="system.actions.{{../index}}.roll_modifier_entries.{{entry.index}}.source_item_ids"
                                                                                    value="{{entry.source_item_ids}}"
                                                                                    placeholder="Ex: Alabarda, abc123 ou Item.xxxxx"
                                                                                />
                                                                            </div>
                                                                        </div>

                                                                        <div class="effect-premium-field">
                                                                            <label class="effect-premium-field-label">
                                                                                <i class="fas fa-gavel" aria-hidden="true"></i>
                                                                                Modo(s) de ataque (ID ou nome; CSV)
                                                                            </label>

                                                                            <div class="effect-premium-field-control">
                                                                                <input
                                                                                    type="text"
                                                                                    name="system.actions.{{../index}}.roll_modifier_entries.{{entry.index}}.source_attack_ids"
                                                                                    value="{{entry.source_attack_ids}}"
                                                                                    placeholder="Ex: Corte, Estocada ou atkA"
                                                                                />
                                                                            </div>
                                                                        </div>

                                                                        <div class="effect-premium-field">
                                                                            <label class="effect-premium-field-label">
                                                                                <i class="fas fa-eye" aria-hidden="true"></i>
                                                                                Exibição NH
                                                                            </label>

                                                                            <div class="effect-premium-field-control">
                                                                                <select
                                                                                    name="system.actions.{{../index}}.roll_modifier_entries.{{entry.index}}.nh_display_mode"
                                                                                >
                                                                                    <option
                                                                                        value="roll_only"
                                                                                        {{#if (eq entry.nh_display_mode "roll_only")}}selected{{/if}}
                                                                                    >
                                                                                        Apenas rolagem
                                                                                    </option>

                                                                                    <option
                                                                                        value="include_in_nh"
                                                                                        {{#if (eq entry.nh_display_mode "include_in_nh")}}selected{{/if}}
                                                                                    >
                                                                                        Incluir no NH
                                                                                    </option>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </details>
                                                        </div>
                                                    {{else}}
                                                        <p class="effect-premium-empty">
                                                            Esta ação não possui uma entrada de modificador válida.
                                                            Remova a ação e crie uma nova.
                                                        </p>
                                                    {{/each}}
                                                </div>
                                            {{/if}}

                                            {{! ============================================= }}
                                            {{! TIPO: MACRO                                   }}
                                            {{! ============================================= }}
                                            {{#if (eq action.type "macro")}}
                                                <div class="effect-premium-grid effect-premium-grid-single">

                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-code" aria-hidden="true"></i>
                                                            Nome da Macro
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <input
                                                                type="text"
                                                                name="system.actions.{{action.index}}.value"
                                                                value="{{action.value}}"
                                                                list="macro-list"
                                                                autocomplete="off"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            {{/if}}

                                            {{! ============================================= }}
                                            {{! TIPO: MENSAGEM DE CHAT                        }}
                                            {{! ============================================= }}
                                            {{#if (eq action.type "chat")}}
                                                <div class="effect-premium-grid effect-premium-grid-chat">

                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-comment" aria-hidden="true"></i>
                                                            Texto
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <textarea
                                                                class="effect-chat-textarea"
                                                                name="system.actions.{{action.index}}.chat_text"
                                                                rows="3"
                                                                placeholder="Texto publicado no chat"
                                                            >{{action.chat_text}}</textarea>
                                                        </div>
                                                    </div>

                                                    <label class="effect-premium-checkbox effect-premium-checkbox-card">
                                                        <input
                                                            type="checkbox"
                                                            name="system.actions.{{action.index}}.has_roll"
                                                            {{checked action.has_roll}}
                                                        />
                                                        <span>Incluir teste?</span>
                                                    </label>
                                                </div>

                                                {{#if action.has_roll}}
                                                    <div class="effect-premium-roll-config">
                                                        <h6>Configuração do Teste</h6>

                                                        <div class="effect-premium-grid effect-premium-grid-chat-roll">

                                                            <div class="effect-premium-field">
                                                                <label class="effect-premium-field-label">
                                                                    <i class="fas fa-tag" aria-hidden="true"></i>
                                                                    Rótulo
                                                                </label>

                                                                <div class="effect-premium-field-control">
                                                                    <input
                                                                        type="text"
                                                                        name="system.actions.{{action.index}}.roll_label"
                                                                        value="{{action.roll_label}}"
                                                                    />
                                                                </div>
                                                            </div>

                                                            <div class="effect-premium-field">
                                                                <label class="effect-premium-field-label">
                                                                    <i class="fas fa-dice-d20" aria-hidden="true"></i>
                                                                    Atributo/Perícia
                                                                </label>

                                                                <div class="effect-premium-field-control">
                                                                    <input
                                                                        type="text"
                                                                        name="system.actions.{{action.index}}.roll_attribute"
                                                                        value="{{action.roll_attribute}}"
                                                                    />
                                                                </div>
                                                            </div>

                                                            <div class="effect-premium-field">
                                                                <label class="effect-premium-field-label">
                                                                    <i class="fas fa-plus" aria-hidden="true"></i>
                                                                    Modificador
                                                                </label>

                                                                <div class="effect-premium-field-control">
                                                                    <input
                                                                        type="text"
                                                                        name="system.actions.{{action.index}}.roll_modifier"
                                                                        value="{{action.roll_modifier}}"
                                                                    />
                                                                </div>
                                                            </div>
</div>
                                                        <div class="effect-premium-field effect-premium-field-full">
                                                            <label class="effect-premium-field-label"><i class="fas fa-bullseye" aria-hidden="true"></i> Finalidades</label>
                                                            <div class="effect-purpose-control">
                                                                <input type="hidden" name="system.actions.{{action.index}}.requestedPurposeIds" value="{{action.requestedPurposeIdsCsv}}" />
                                                                <button type="button" class="open-purpose-picker" data-target-input="system.actions.{{action.index}}.requestedPurposeIds" data-attribute-input="system.actions.{{action.index}}.roll_attribute"><i class="fas fa-list-check"></i> Selecionar finalidades</button>
                                                                <span class="effect-purpose-summary">{{action.purposeSelectionSummary}}</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {{/if}}
                                            {{/if}}

                                            {{! ============================================= }}
                                            {{! TIPO: FLAG                                    }}
                                            {{! ============================================= }}
                                            {{#if (eq action.type "flag")}}
                                                <div class="effect-premium-grid effect-premium-grid-flag">

                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-key" aria-hidden="true"></i>
                                                            Chave
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <input
                                                                type="text"
                                                                name="system.actions.{{action.index}}.key"
                                                                value="{{action.key}}"
                                                            />
                                                        </div>
                                                    </div>

                                                    <div class="effect-premium-field">
                                                        <label class="effect-premium-field-label">
                                                            <i class="fas fa-toggle-on" aria-hidden="true"></i>
                                                            Valor
                                                        </label>

                                                        <div class="effect-premium-field-control">
                                                            <input
                                                                type="text"
                                                                name="system.actions.{{action.index}}.flag_value"
                                                                value="{{action.flag_value}}"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            {{/if}}
                                        </div>
                                    </div>
                                </details>
                            {{/each}}
                        </div>

                    {{else}}
                        <p class="hint effect-premium-empty">
                            Nenhuma ação configurada. Clique em
                            <strong>Adicionar Ação</strong>.
                        </p>
                    {{/if}}

                    <datalist id="roll-mod-context-options">
                        {{#each rollModifierContextOptions as |ctx|}}
                            <option value="{{ctx.id}}">{{ctx.label}}</option>
                        {{/each}}
                    </datalist>

                    <datalist id="macro-list">
                        {{#each macros as |macroName|}}
                            <option value="{{macroName}}">
                        {{/each}}
                    </datalist>
                </section>
            </div>

            {{! ===================================================== }}
            {{! ABA: DESCRIÇÃO                                        }}
            {{! ===================================================== }}
            <div class="tab active" data-tab="description" data-group="primary">
                <div class="description-tab">
                    <div class="description-grid">

                        <div
                            class="form-group"
                            style="flex-direction: row; text-align: center;"
                        >
                            <label title="Livro e Página de Referência">
                                <a class="open-reference-link" title="Abrir Referência">
                                    <i class="fas fa-book-open"></i>
                                </a>
                                REF
                            </label>

                            <div class="input-row">
                                <input
                                    type="text"
                                    name="system.ref"
                                    value="{{system.ref}}"
                                    placeholder="Ex: BA23, MA45"
                                />
                            </div>
                        </div>

                        <div class="form-section description-section itemdesc-block">
                            <details class="itemdesc-panel" open>
                                <summary class="itemdesc-block-header">
                                    <h4 class="itemdesc-block-title">
                                        Descrição Resumida (Chat)
                                    </h4>
                                </summary>

                                {{#if editable}}
                                    <span class="itemdesc-header-actions">
                                        <button
                                            type="button"
                                            class="toggle-editor itemdesc-edit-button"
                                            data-field="system.chat_description"
                                        >
                                            <i class="fas fa-pen"></i>
                                        </button>
                                    </span>
                                {{/if}}

                                <div class="itemdesc-content">
                                    <div class="description-view itemdesc-inner">
                                        {{{enrichedChatDescription}}}
                                    </div>

                                    <div
                                        class="description-editor itemdesc-inner"
                                        style="display: none;"
                                    >
                                        {{editor
                                            system.chat_description
                                            target="system.chat_description"
                                            engine="prosemirror"
                                            owner=owner
                                            editable=editable
                                        }}

                                        <div class="description-actions">
                                            <button
                                                type="button"
                                                class="save-description"
                                                data-field="system.chat_description"
                                            >
                                                <i class="fas fa-save"></i>
                                                Salvar
                                            </button>

                                            <button
                                                type="button"
                                                class="expand-description"
                                                data-expanded="false"
                                            >
                                                <i class="fas fa-expand"></i>
                                                Expandir
                                            </button>

                                            <button
                                                type="button"
                                                class="cancel-description"
                                            >
                                                <i class="fas fa-times"></i>
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        </div>

                        <div class="form-section description-section itemdesc-block">
                            <details class="itemdesc-panel" open>
                                <summary class="itemdesc-block-header">
                                    <h4 class="itemdesc-block-title">
                                        Descrição Completa
                                    </h4>
                                </summary>

                                {{#if editable}}
                                    <span class="itemdesc-header-actions">
                                        <button
                                            type="button"
                                            class="toggle-editor itemdesc-edit-button"
                                            data-field="system.description"
                                        >
                                            <i class="fas fa-pen"></i>
                                        </button>
                                    </span>
                                {{/if}}

                                <div class="itemdesc-content">
                                    <div class="description-view itemdesc-inner">
                                        {{{enrichedDescription}}}
                                    </div>

                                    <div
                                        class="description-editor itemdesc-inner"
                                        style="display: none;"
                                    >
                                        {{editor
                                            system.description
                                            target="system.description"
                                            engine="prosemirror"
                                            owner=owner
                                            editable=editable
                                        }}

                                        <div class="description-actions">
                                            <button
                                                type="button"
                                                class="save-description"
                                                data-field="system.description"
                                            >
                                                <i class="fas fa-save"></i>
                                                Salvar
                                            </button>

                                            <button
                                                type="button"
                                                class="expand-description"
                                                data-expanded="false"
                                            >
                                                <i class="fas fa-expand"></i>
                                                Expandir
                                            </button>

                                            <button
                                                type="button"
                                                class="cancel-description"
                                            >
                                                <i class="fas fa-times"></i>
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </details>
                        </div>
                    </div>
                </div>
            </div>

            {{! ===================================================== }}
            {{! ABA: CONFIGURAÇÃO                                     }}
            {{! ===================================================== }}
            <div class="tab" data-tab="configuracao" data-group="primary">

                <div
                    class="effect-row-grid effect-duration-grid is-two-col-rows"
                    style="margin: 5px;"
                >
                    <div class="effect-field effect-field-row">
                        <div class="effect-label">Ícone no Token</div>

                        <select name="system.tokenIconPolicy">
                            {{#each tokenIconPolicyOptions as |policy|}}
                                <option
                                    value="{{policy.id}}"
                                    {{#if (eq ../system.tokenIconPolicy policy.id)}}selected{{/if}}
                                >
                                    {{policy.label}}
                                </option>
                            {{/each}}
                        </select>
                    </div>

                 <div class="effect-field effect-field-row">
                        <div class="effect-label">Acúmulo por Condições</div>

                        <select
                            name="system.conditionStackingMode"
                            title="Define se este mesmo Item Efeito pode ser acumulado quando condições diferentes estiverem ativas."
                        >
                            {{#each conditionStackingModeOptions as |mode|}}
                                <option
                                    value="{{mode.id}}"
                                    {{#if (eq ../system.conditionStackingMode mode.id)}}selected{{/if}}
                                >
                                    {{mode.label}}
                                </option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                {{#if (eq system.conditionStackingMode "unique")}}
                    <p class="hint" style="margin: 0 10px 10px;">
                        Enquanto duas ou mais condições vincularem este mesmo Item Efeito, somente uma cópia de cada ação persistente será aplicada ao personagem. O efeito permanece ativo até a última dessas condições ser desligada.
                    </p>
                {{/if}}

 {{!-- DURAÇÃO E EXPIRAÇÃO --}}
                {{#if hasTimedActions}}
                    <section class="effect-card effect-section">
                        <div class="effect-section-header">
                            <h4 class="effect-section-title">
                                Duração do Efeito
                            </h4>

                            <div class="effect-section-select">
                                <select
                                    class="duration-mode-select"
                                    name="system.duration._uiMode"
                                >
                                    <option
                                        value="permanent"
                                        {{#if system.duration.isPermanent}}selected{{/if}}
                                    >
                                        Permanente
                                    </option>

                                    <option
                                        value="combat"
                                        {{#if (and (not system.duration.isPermanent) system.duration.inCombat)}}selected{{/if}}
                                    >
                                        Temporária/Combate
                                    </option>
                                </select>
                            </div>
                        </div>

                        <input
                            type="checkbox"
                            class="duration-hidden"
                            name="system.duration.isPermanent"
                            {{checked system.duration.isPermanent}}
                        />

                        <input
                            type="checkbox"
                            class="duration-hidden"
                            name="system.duration.inCombat"
                            {{checked system.duration.inCombat}}
                        />

                        <div class="effect-section-body">

                            {{#if system.duration.isPermanent}}
                                <p class="hint">
                                    O efeito aparecerá no campo "Efeitos Passivos"
                                    da ficha do personagem.
                                </p>
                            {{/if}}

                            {{#unless system.duration.isPermanent}}
                                {{#if system.duration.inCombat}}
                                    <div class="effect-row-grid effect-duration-grid is-two-col-rows">

                                        <div class="effect-field effect-field-row">
                                            <div class="effect-label">
                                                Início da contagem
                                            </div>

                                            <select
                                                class="effect-dropmenu-text"
                                                name="system.duration.startMode"
                                            >
                                                <option
                                                    value="apply"
                                                    {{#if (eq system.duration.startMode "apply")}}selected{{/if}}
                                                >
                                                    Ao aplicar
                                                </option>

                                                <option
                                                    value="nextTurnStart"
                                                    {{#if (eq system.duration.startMode "nextTurnStart")}}selected{{/if}}
                                                >
                                                    No início do próximo turno
                                                </option>
                                            </select>
                                        </div>

                                        <div class="effect-field effect-field-row">
                                            <div class="effect-label">
                                                Rodadas (seg)
                                            </div>

                                            <input
                                                type="number"
                                                name="system.duration.value"
                                                value="{{system.duration.value}}"
                                                min="1"
                                            />
                                        </div>

                                        <div class="effect-field effect-field-row">
                                            <div class="effect-label">
                                                Fim da contagem
                                            </div>

                                            <select name="system.duration.endMode">
                                                <option
                                                    value="turnStart"
                                                    {{#if (eq system.duration.endMode "turnStart")}}selected{{/if}}
                                                >
                                                    No início do turno final
                                                </option>

                                                <option
                                                    value="turnEnd"
                                                    {{#if (eq system.duration.endMode "turnEnd")}}selected{{/if}}
                                                >
                                                    No fim do turno final
                                                </option>
                                            </select>
                                        </div>
                                    </div>
                                {{/if}}
                            {{/unless}}
                        </div>
                    </section>
                {{/if}}

                {{!-- BARREIRA DE RESISTÊNCIA --}}
                <section class="effect-card effect-section effect-resistance-section">
                    <div class="effect-section-header">
                        <h4 class="effect-section-title">
                            Barreira de Resistência
                        </h4>

                        <label
                            class="effect-section-toggle"
                            title="Ativar registro de barreira"
                        >
                            <input
                                type="checkbox"
                                name="system.resistanceRoll.isResisted"
                                {{checked system.resistanceRoll.isResisted}}
                            />
                            <span></span>
                        </label>
                    </div>

                    <div
                        class="
                             effect-section-body effect-resistance-body
                            {{#unless system.resistanceRoll.isResisted}}is-muted{{/unless}}
                        "
                    >
                        <div
                            class="effect-field effect-field-full"
                            style="margin-bottom: 10px;"
                        >
                            <div class="effect-label">
                                Texto no card de resistência
                            </div>

                            <textarea
                                name="system.resistanceRoll.chatText"
                                rows="2"
                                placeholder="Opcional"
                                {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                            >{{system.resistanceRoll.chatText}}</textarea>
                        </div>

                        <div class="effect-row-grid resistance-settings-row">
                            <div class="effect-field resistance-setting-card resistance-mode-field">
                                <div class="effect-label">Modo de aplicação</div>
                                <select name="system.resistanceRoll.mode" {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}>
                                    <option value="simple" {{#unless isConditionalResistance}}selected{{/unless}}>Simples — aplicar todas as ações</option>
                                    <option value="conditional" {{#if isConditionalResistance}}selected{{/if}}>Resultados condicionais</option>
                                </select>
                            </div>

                            <div class="effect-field resistance-setting-card resistance-visibility-field">
                                <div class="effect-label">Visibilidade do teste</div>
                                <select name="system.resistanceRoll.chatVisibility" {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}>
                                    <option value="public" {{#if (eq system.resistanceRoll.chatVisibility "public")}}selected{{/if}}>Público (todos)</option>
                                    <option value="owners" {{#unless (or (eq system.resistanceRoll.chatVisibility "public") (eq system.resistanceRoll.chatVisibility "target"))}}selected{{/unless}}>Alvo e Mestre</option>
                                    <option value="target" {{#if (eq system.resistanceRoll.chatVisibility "target")}}selected{{/if}}>Somente o alvo</option>
                                </select>
                            </div>
                        </div>

                        <div class="effect-row-grid effect-resistance-grid">

                            <div class="effect-field {{#if isConditionalResistance}}is-hidden{{/if}}">
                                <div class="effect-label">
                                    Aplicar efeito em
                                </div>

                                <select
                                    name="system.resistanceRoll.applyOn"
                                    {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                                >
                                    <option
                                        value="failure"
                                        {{#if (eq system.resistanceRoll.applyOn "failure")}}selected{{/if}}
                                    >
                                        Em Falha
                                    </option>

                                    <option
                                        value="success"
                                        {{#if (eq system.resistanceRoll.applyOn "success")}}selected{{/if}}
                                    >
                                        Em Sucesso
                                    </option>
                                </select>
                            </div>

                            <div class="effect-field">
                                <div class="effect-label">Atributo</div>

                                <input
                                    type="text"
                                    name="system.resistanceRoll.attribute"
                                    value="{{system.resistanceRoll.attribute}}"
                                    {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                                />
                            </div>

                            <div class="effect-field {{#if isConditionalResistance}}is-hidden{{/if}}">
                                <div class="effect-label">Margem Min</div>

                                <input
                                    type="text"
                                    name="system.resistanceRoll.margin"
                                    value="{{system.resistanceRoll.margin}}"
                                    placeholder="Opcional"
                                    {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                                />
                            </div>
                        </div>

                        <div
                            class="effect-field"
                            style="margin-bottom: 15px;"
                        >
                            <div class="effect-label">Modificador</div>

                            <input
                                type="text"
                                name="system.resistanceRoll.modifier"
                                value="{{system.resistanceRoll.modifier}}"
                                {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                            />
                        </div>

                        {{#if isConditionalResistance}}
                            <div class="resistance-branches">
                                <div class="resistance-branches-header">
                                    <div>Resultados (todas as condições compatíveis serão aplicadas)</div>
                                    <button type="button" class="add-resistance-branch"><i class="fas fa-plus"></i> Adicionar resultado</button>
                                </div>
                                {{#each resistanceBranches as |branch|}}
                                    <article class="resistance-branch" data-branch-index="{{branch.index}}">
                                        <input type="hidden" name="system.resistanceRoll.branches.{{branch.index}}.id" value="{{branch.id}}">
                                        <div class="resistance-branch-heading">
                                            <input type="text" name="system.resistanceRoll.branches.{{branch.index}}.label" value="{{branch.label}}" aria-label="Nome do resultado">
                                            <button type="button" class="move-resistance-branch" data-index="{{branch.index}}" data-direction="-1" title="Mover para cima"><i class="fas fa-arrow-up"></i></button>
                                            <button type="button" class="move-resistance-branch" data-index="{{branch.index}}" data-direction="1" title="Mover para baixo"><i class="fas fa-arrow-down"></i></button>
                                            <button type="button" class="remove-resistance-branch" data-index="{{branch.index}}" title="Remover resultado"><i class="fas fa-trash"></i></button>
                                        </div>
                                        <div class="resistance-branch-condition">
                                            <span class="resistance-condition-label">Condição</span>
                                            <select name="system.resistanceRoll.branches.{{branch.index}}.condition.type" aria-label="Tipo de condição">
                                                <option value="outcome" {{#unless branch.isOtherwise}}selected{{/unless}}>Resultado do teste</option>
                                                <option value="otherwise" {{#if branch.isOtherwise}}selected{{/if}}>Nenhuma outra condição</option>
                                            </select>
                                            <select name="system.resistanceRoll.branches.{{branch.index}}.condition.outcome" aria-label="Resultado do teste" {{#if branch.isOtherwise}}disabled{{/if}}>
                                                <option value="failure" {{#unless branch.isSuccess}}selected{{/unless}}>Falha</option>
                                                <option value="success" {{#if branch.isSuccess}}selected{{/if}}>Sucesso</option>
                                            </select>
                                            <label>Margem mín. <input type="number" min="0" step="1" name="system.resistanceRoll.branches.{{branch.index}}.condition.minimumMargin" value="{{branch.condition.minimumMargin}}" {{#if branch.isOtherwise}}disabled{{/if}}></label>
                                            <label>Margem máx. <input type="number" min="0" step="1" name="system.resistanceRoll.branches.{{branch.index}}.condition.maximumMargin" value="{{branch.maximumMargin}}" placeholder="Sem limite" {{#if branch.isOtherwise}}disabled{{/if}}></label>
                                        </div>
                                        <input type="hidden" name="system.resistanceRoll.branches.{{branch.index}}.actionIds" value="{{branch.actionIdsCsv}}">
                                        <div class="resistance-branch-actions">
                                            <span class="resistance-action-summary">{{branch.actionSummary}}</span>
                                            <button type="button" class="select-resistance-actions" data-index="{{branch.index}}"><i class="fas fa-search"></i> Selecionar ações</button>
                                        </div>
                                    </article>
                                {{else}}
                                    <p class="hint">Adicione um resultado e escolha quais ações ele deve aplicar.</p>
                                {{/each}}
                            </div>
                        {{/if}}

                        <label class="custom-checkbox block effect-inline-checkbox">
                            <input
                                type="checkbox"
                                name="system.resistanceRoll.skipPromptCard"
                                {{checked system.resistanceRoll.skipPromptCard}}
                                {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}
                            />

                            <span>
                                Realizar o teste automaticamente, mas não publicar no chat.
                            </span>
                        </label>

                        <div class="effect-field effect-field-full" style="margin-bottom: 15px;">
                            <div class="effect-purpose-control resistance-purpose-control">
                                <input type="hidden" name="system.resistanceRoll.requestedPurposeIds" value="{{resistancePurposeIdsCsv}}" />
                                <div class="resistance-purpose-heading">
                                    <div class="effect-label">Finalidades do teste</div>
                                    <button type="button" class="open-purpose-picker resistance-purpose-add" data-target-input="system.resistanceRoll.requestedPurposeIds" data-attribute-input="system.resistanceRoll.attribute" {{#unless system.resistanceRoll.isResisted}}disabled{{/unless}}><i class="fas fa-pen-nib" aria-hidden="true"></i> Editar finalidades</button>
                                </div>
                                <div class="resistance-purpose-list{{#unless resistancePurposeLabels.length}} is-empty{{/unless}}" aria-live="polite">
                                    {{#each resistancePurposeLabels as |purposeLabel|}}
                                        <span class="resistance-purpose-item">{{purposeLabel}}</span>
                                    {{else}}
                                        <span class="resistance-purpose-empty">Nenhuma finalidade adicionada</span>
                                    {{/each}}
                                </div>
                            </div>
                        </div>


                     </div>
                </section>
            </div>
        </div>
    </main>
</form>
