<form class="eqp-modifier-browser-form gum-browser" autocomplete="off">
    <div class="browser-container">
        
        {{!-- Sidebar (Filtros) --}}
        <div class="browser-sidebar">
            
  <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.EquipmentModifierBrowser.Search"}}</h3>
                <div class="search-box">
                    <input type="text" name="search" placeholder="{{localize "GUM.EquipmentModifierBrowser.SearchPlaceholder"}}" value="{{filters.search}}" autocomplete="off">
                    <i class="fas fa-search"></i>
                </div>
            </div>

            {{#if folders.length}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.Common.Folders"}}</h3>
                <div class="radio-filter-list">
                    {{#each folders as |folder|}}
                    <label class="filter-radio">
                        <input type="checkbox" name="filter-folder" value="{{folder.id}}">
                        <span>{{folder.name}}</span>
                    </label>
                    {{/each}}
                </div>
            </div>
            {{/if}}

            {{!-- Checkboxes de Categoria --}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.EquipmentModifierBrowser.Category"}}</h3>
                <div class="radio-filter-list">
                    
                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="all" {{checked filters.categories.all}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.all"}}</span>
                    </label>
                    
                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="general" {{checked filters.categories.general}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.general"}}</span>
                    </label>
                    
                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="enchantment" {{checked filters.categories.enchantment}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.enchantment"}}</span>
                    </label>

                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="melee" {{checked filters.categories.melee}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.melee"}}</span>
                    </label>
                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="ranged" {{checked filters.categories.ranged}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.ranged"}}</span>
                    </label>

                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="armor" {{checked filters.categories.armor}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.armor"}}</span>
                    </label>
                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="shield" {{checked filters.categories.shield}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.shield"}}</span>
                    </label>
                    
                    <label class="filter-radio">
                        <input type="checkbox" class="category-filter" value="ammo" {{checked filters.categories.ammo}}>
                        <span>{{localize "GUM.EquipmentModifierBrowser.Categories.ammo"}}</span>
                    </label>
                </div>
            </div>

            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.EquipmentModifierBrowser.CostFactor"}}</h3>
                <div class="cf-range-inputs">
                    <input type="number" name="cfMin" placeholder="{{localize "GUM.EquipmentModifierBrowser.Min"}}" step="0.1">
                    <span class="range-sep">-</span>
                    <input type="number" name="cfMax" placeholder="{{localize "GUM.EquipmentModifierBrowser.Max"}}" step="0.1">
                </div>
            </div>
        </div>

        {{!-- Lista de Resultados --}}
        <main class="browser-content">
            <ol class="results-list">
                {{#each modifiers}}
                <li class="result-item" 
                     data-id="{{this.id}}" 
                     data-cf="{{this.system.cost_factor}}"
                     data-tags="{{this.system.tags}}"
                     data-folder-id="{{this.folderId}}"
                     data-cat-general="{{this.system.target_type.general}}"
                     data-cat-enchantment="{{this.system.target_type.enchantment}}"
                     data-cat-melee="{{this.system.target_type.melee}}"
                     data-cat-ranged="{{this.system.target_type.ranged}}"
                     data-cat-armor="{{this.system.target_type.armor}}"
                     data-cat-shield="{{this.system.target_type.shield}}"
                     data-cat-ammo="{{this.system.target_type.ammo}}"
                     >
                     
                    <div class="item-icon">
                        {{#if this.displayImg}}
                            <img src="{{this.displayImg}}" alt="{{this.name}}">
                        {{/if}}
                    </div>
                    
                    <div class="item-info">
                        <span class="item-name">{{this.name}}</span>
                    </div>

                    <div class="item-actions">
                        <button type="button" class="browser-quick-view" data-id="{{this.id}}" title="{{localize "GUM.EquipmentModifierBrowser.ViewTooltip"}}">
                            <i class="fas fa-eye"></i>
                        </button>
                        <label class="item-select">
                            <input type="checkbox" name="{{this.id}}">
                        </label>
                    </div>
                </li>
                {{else}}
                <li class="placeholder-text">{{localize "GUM.EquipmentModifierBrowser.NoResults"}}</li>
                {{/each}}
            </ol>
        </main>
    </div>

    <footer class="browser-footer">
        <button type="submit" name="submit">
            <i class="fas fa-plus"></i> {{localize "GUM.EquipmentModifierBrowser.AddSelected"}}
        </button>
    </footer>
</form>