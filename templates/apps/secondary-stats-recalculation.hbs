<form class="secondary-stats-preview">
  <header class="secondary-preview-header">
    <span class="secondary-preview-header-icon"><i class="fas fa-sync-alt"></i></span>
    <div>
      <p>{{localize "GUM.SecondaryStatsRecalculation.Introduction"}}</p>
      <small><i class="fas fa-layer-group"></i> {{localize "GUM.SecondaryStatsRecalculation.PreparedValuesHint"}}</small>
    </div>
  </header>

  <nav class="secondary-preview-actions" aria-label="{{localize 'GUM.SecondaryStatsRecalculation.QuickActions'}}">
    <button type="button" data-action="recommended"><i class="fas fa-star"></i> {{localize "GUM.SecondaryStatsRecalculation.Recommended"}}</button>
    <button type="button" data-action="all"><i class="fas fa-check-double"></i> {{localize "GUM.SecondaryStatsRecalculation.All"}}</button>
    <button type="button" data-action="none"><i class="far fa-square"></i> {{localize "GUM.SecondaryStatsRecalculation.Clear"}}</button>
    <button type="button" data-action="unchanged" aria-pressed="false"><i class="fas fa-eye"></i> {{localize "GUM.SecondaryStatsRecalculation.ShowUnchanged"}}</button>
  </nav>

  <div class="secondary-preview-column-labels" aria-hidden="true">
    <span>{{localize "GUM.SecondaryStatsRecalculation.Attribute"}}</span><span>{{localize "GUM.SecondaryStatsRecalculation.Current"}}</span><span></span><span>{{localize "GUM.SecondaryStatsRecalculation.Calculated"}}</span>
  </div>

  <div class="secondary-preview-groups">
    {{#each groups}}
    <details class="secondary-preview-group" open>
      <summary>
        <span class="secondary-group-identity"><i class="{{icon}}"></i><strong>{{label}}</strong></span>
        <span class="secondary-group-meta">{{changedLabel}}</span>
        <label class="secondary-group-selector" title="{{localize 'GUM.SecondaryStatsRecalculation.ToggleGroup'}}">
          <input type="checkbox" class="secondary-group-toggle" data-group="{{id}}" checked />
          <span></span>
        </label>
        <i class="fas fa-chevron-down secondary-group-chevron"></i>
      </summary>
      <div class="secondary-group-cards">
        {{#each entries}}
        <article class="secondary-stat-row {{#unless visible}}unchanged{{/unless}} {{#if protectedByOverride}}protected{{/if}}">
          <label class="secondary-field-selector">
            <input type="checkbox" name="secondary-stat" value="{{id}}" data-group="{{group}}" {{#if selectedByDefault}}checked{{/if}} {{#unless changed}}disabled{{/unless}} />
            <span></span>
          </label>
          <div class="secondary-stat-content">
            <div class="secondary-stat-main">
              <strong>{{label}}</strong>
              <span class="secondary-value current">{{currentValue}}</span>
              <i class="fas fa-arrow-right secondary-value-arrow"></i>
              <span class="secondary-value proposed">{{proposedValue}}</span>
            </div>
            <div class="secondary-stat-meta">
              <small>{{reason}}</small>
              {{#if protectedByOverride}}
                <span class="secondary-status protected"><i class="fas fa-lock"></i> {{localize "GUM.SecondaryStatsRecalculation.Override"}}</span>
              {{else}}
                {{#if changed}}<span class="secondary-status changed">{{localize "GUM.SecondaryStatsRecalculation.Changed"}}</span>{{else}}<span class="secondary-status stable">{{localize "GUM.SecondaryStatsRecalculation.Unchanged"}}</span>{{/if}}
              {{/if}}
            </div>
            {{#if changed}}
              {{#if modifierDetail}}<small class="secondary-stat-detail">{{modifierDetail}}</small>{{/if}}
              {{#if finalComparisonDetail}}<small class="secondary-stat-detail">{{finalComparisonDetail}}</small>{{/if}}
            {{/if}}
            {{#each warnings}}<small class="secondary-stat-warning"><i class="fas fa-exclamation-triangle"></i> {{this}}</small>{{/each}}
            {{#if dependencies.length}}<small hidden class="secondary-dependency-warning" data-dependencies="{{dependencies}}"><i class="fas fa-link"></i> {{localize "GUM.SecondaryStatsRecalculation.DependencyWarning"}}</small>{{/if}}
          </div>
        </article>
        {{/each}}
      </div>
    </details>
    {{/each}}
  </div>
</form>