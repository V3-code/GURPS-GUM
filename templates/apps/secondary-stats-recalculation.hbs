<form class="secondary-stats-preview">
  <header class="secondary-preview-header">
    <span class="secondary-preview-header-icon"><i class="fas fa-sync-alt"></i></span>
    <div>
      <p>Analise os ajustes que serão feitos no Personagem escolha o que deseja aplicar.</p>
      <small><i class="fas fa-layer-group"></i> ST, DX, HT e Per usam seus valores finais, incluindo efeitos e modificadores aplicáveis.</small>
    </div>
  </header>

    <label class="secondary-preview-option">
    <input type="checkbox" name="consider-basic-speed-fixed-modifier" {{#if considerBasicSpeedFixedModifier}}checked{{/if}} />
    <span>
      <strong>Considerar o modificador fixo da Velocidade</strong>
      <small>Usa a Velocidade com o ajuste manual para calcular Deslocamento e Esquiva.</small>
    </span>
  </label>

  <nav class="secondary-preview-actions" aria-label="Ações rápidas">
    <button type="button" data-action="recommended"><i class="fas fa-star"></i> Recomendados</button>
    <button type="button" data-action="all"><i class="fas fa-check-double"></i> Todos</button>
    <button type="button" data-action="none"><i class="far fa-square"></i> Limpar</button>
    <button type="button" data-action="unchanged" aria-pressed="false"><i class="fas fa-eye"></i> Sem alteração</button>
  </nav>

  <div class="secondary-preview-column-labels" aria-hidden="true">
    <span>Atributo</span><span>Atual</span><span></span><span>Calculado</span>
  </div>

  <div class="secondary-preview-groups">
    {{#each groups}}
    <details class="secondary-preview-group" open>
      <summary>
        <span class="secondary-group-identity"><i class="{{icon}}"></i><strong>{{label}}</strong></span>
        <span class="secondary-group-meta">{{changedCount}} alteração(ões)</span>
        <label class="secondary-group-selector" title="Selecionar ou desmarcar o grupo">
          <input type="checkbox" class="secondary-group-toggle" data-group="{{id}}" checked />
          <span></span>
        </label>
        <i class="fas fa-chevron-down secondary-group-chevron"></i>
      </summary>
      <div class="secondary-group-cards">
        {{#each entries}}
        <article class="secondary-stat-row {{#unless visible}}unchanged{{/unless}} {{#if protectedByOverride}}protected{{/if}}">
          <label class="secondary-field-selector">
            <input type="checkbox" name="secondary-stat" value="{{id}}" data-group="{{group}}" {{#if selectedByDefault}}checked{{/if}} {{#unless changed}}disabled{{/unless}} />
            <span></span>
          </label>
          <div class="secondary-stat-content">
            <div class="secondary-stat-main">
              <strong>{{label}}</strong>
              <span class="secondary-value current">{{currentValue}}</span>
              <i class="fas fa-arrow-right secondary-value-arrow"></i>
              <span class="secondary-value proposed">{{proposedValue}}</span>
            </div>
            <div class="secondary-stat-meta">
              <small>{{reason}}</small>
              {{#if protectedByOverride}}
                <span class="secondary-status protected"><i class="fas fa-lock"></i> Override</span>
              {{else}}
                {{#if changed}}<span class="secondary-status changed">Alteração</span>{{else}}<span class="secondary-status stable">Sem alteração</span>{{/if}}
              {{/if}}
            </div>
            {{#if changed}}
              {{#if modifierTotal}}<small class="secondary-stat-detail">Base {{proposedValue}} <span>·</span> modificadores {{modifierTotal}} <span>·</span> final estimado {{proposedFinal}}</small>{{/if}}
              {{#if currentFinal}}<small class="secondary-stat-detail">Final atual {{currentFinal}} <span>·</span> final estimado {{proposedFinal}}</small>{{/if}}
            {{/if}}
            {{#each warnings}}<small class="secondary-stat-warning"><i class="fas fa-exclamation-triangle"></i> {{this}}</small>{{/each}}
            {{#if dependencies.length}}<small hidden class="secondary-dependency-warning" data-dependencies="{{dependencies}}"><i class="fas fa-link"></i> Seleção parcial: este resultado depende de outro atributo recalculável não selecionado.</small>{{/if}}
          </div>
        </article>
        {{/each}}
      </div>
    </details>
    {{/each}}
  </div>
</form>