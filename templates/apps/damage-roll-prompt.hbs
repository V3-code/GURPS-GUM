<form class="gum-damage-roll-prompt premium" autocomplete="off">
  <header class="damage-prompt-header">
    <div class="header-kicker">{{localize "GUM.DamageRollPrompt.Heading"}}</div>
    <h2>{{sourceName}}</h2>
  </header>

  <section class="damage-visual-box">
    {{#each visualCards as |card|}}
      <div class="damage-visual-card tone-{{card.tone}}">
        <div class="damage-card-formula">{{card.formula}}</div>
        <div class="damage-card-meta">{{#if card.type}}{{card.type}}{{/if}}</div>
      </div>
    {{/each}}
  </section>
  <section class="damage-modifier-section">
    <h4>{{localize "GUM.DamageRollPrompt.SituationalModifiers"}}</h4>

    <div class="damage-row">
      <label>{{localize "GUM.DamageRollPrompt.StandardDamage"}}</label>
      <input type="text" name="mainAdditional" data-formula-input="true" placeholder="{{localize 'GUM.DamageRollPrompt.StandardPlaceholder'}}" />
      <input type="text" value="{{main.type}}" disabled />
    </div>

    <div class="damage-row">
      <label>{{localize "GUM.DamageRollPrompt.FragmentationDamage"}}</label>
      <input type="text" name="fragmentationAdditional" data-formula-input="true" placeholder="{{localize 'GUM.DamageRollPrompt.FragmentationPlaceholder'}}" />
      {{#if fragmentationTypeLocked}}
        <input type="text" value="{{fragmentation.type}}" disabled />
      {{else}}
        <input type="text" name="fragmentationType" data-type-input="true" placeholder="{{localize 'GUM.DamageRollPrompt.TypePlaceholder'}}" />
      {{/if}}
    </div>

    <div class="damage-row">
      <label>{{localize "GUM.DamageRollPrompt.FollowUpDamage"}}</label>
      <input type="text" name="followUpAdditional" data-formula-input="true" placeholder="{{localize 'GUM.DamageRollPrompt.FollowUpPlaceholder'}}" />
      {{#if followUpTypeLocked}}
        <input type="text" value="{{followUp.type}}" disabled />
      {{else}}
        <input type="text" name="followUpType" data-type-input="true" placeholder="{{localize 'GUM.DamageRollPrompt.TypePlaceholder'}}" />
      {{/if}}
    </div>
  </section>

  <footer class="damage-prompt-actions">
    <button type="submit" title="{{localize 'GUM.DamageRollPrompt.RollTooltip'}}"><i class="fas fa-dice"></i> {{localize "GUM.DamageRollPrompt.Roll"}}</button>
    <button type="button" data-action="cancel">{{localize "GUM.Common.Cancel"}}</button>
  </footer>
</form>
