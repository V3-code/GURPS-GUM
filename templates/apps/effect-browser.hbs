<form class="effect-browser-form gum-browser">

    {{#if invalidSources.length}}
    <div class="notification warning">
        <strong>{{localize "GUM.EffectBrowser.InvalidSources"}}</strong>
        {{#each invalidSources as |source|}}<code>{{source.id}}</code>{{#unless @last}}, {{/unless}}{{/each}}
    </div>
    {{/if}}

    <div class="browser-container">

        {{!-- Coluna da Esquerda (Sidebar de Filtros Simplificada) --}}
        <aside class="browser-sidebar">
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.EffectBrowser.Search"}}</h3>
                <div class="search-box">
                    <input type="text" name="search" placeholder="{{localize 'GUM.EffectBrowser.SearchPlaceholder'}}"/>
                    <i class="fas fa-search"></i>
                </div>
            </div>

            {{#if folders.length}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.EffectBrowser.Folders"}}</h3>
                {{#each folders as |folder|}}
                <label class="filter-check"><input type="checkbox" name="filter-folder" value="{{folder.id}}"/> <span>{{folder.name}}</span></label>
                {{/each}}
            </div>
            {{/if}}
            
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.EffectSheet.Type"}}</h3>
                <label class="filter-check"><input type="checkbox" name="filter-attribute" checked/> <span>{{localize "GUM.EffectSheet.Attribute"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-status" checked/> <span>{{localize "GUM.EffectSheet.Status"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-roll_modifier" checked/> <span>{{localize "GUM.EffectBrowser.RollModifierShort"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-skill_modifier" checked/> <span>{{localize "GUM.EffectBrowser.SkillModifierShort"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-combat_modifier" checked/> <span>{{localize "GUM.EffectBrowser.CombatModifierShort"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-resource_change" checked/> <span>{{localize "GUM.EffectSheet.ChangeResource"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-resource_create" checked/> <span>{{localize "GUM.EffectSheet.CreateResource"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-chat" checked/> <span>Chat</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-macro" checked/> <span>Macro</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-flag" checked/> <span>Flag</span></label>
            </div>

        </aside>

        {{!-- Coluna da Direita (Resultados Adaptados para Efeitos) --}}
        <main class="browser-content">
            <ol class="results-list">
                {{#each effects as |effect|}}
                <li class="result-item" data-item-id="{{effect.id}}" data-selection-key="{{effect.selectionKey}}">
                    
                    <div class="item-icon">
                        {{#if effect.displayImg}}
                            <img src="{{effect.displayImg}}" alt="{{effect.name}}"/>
                        {{/if}}
                    </div>

                    <div class="item-info">
                        <span class="item-name">{{effect.name}}</span>
                    </div>

                    <div class="item-actions">
                        <button type="button" class="browser-quick-view" data-id="{{effect.id}}" title="{{localize 'GUM.EffectBrowser.Preview'}}">
                            <i class="fas fa-eye"></i>
                        </button>
                        <label class="item-select">
                            <input type="checkbox" name="{{effect.selectionKey}}" />
                        </label>
                    </div>
                </li>
                {{else}}
                <li class="placeholder-text">{{localize "GUM.EffectBrowser.Empty"}}</li>
                {{/each}}
            </ol>
        </main>

    </div>

    <footer class="browser-footer">
        <button type="submit">
            <i class="fas fa-check"></i> {{localize "GUM.EffectBrowser.AddSelected"}}
        </button>
    </footer>

</form>
