<form class="condition-browser-form gum-browser">

    <div class="browser-container">

        <aside class="browser-sidebar">
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.ConditionBrowser.Search"}}</h3>
                <div class="search-box">
                    <input type="text" name="search" placeholder="{{localize "GUM.ConditionBrowser.SearchPlaceholder"}}"/>
                    <i class="fas fa-search"></i>
                </div>
            </div>

            {{#if folders.length}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.Common.Folders"}}</h3>
                {{#each folders as |folder|}}
                <label class="filter-check"><input type="checkbox" name="filter-folder" value="{{folder.id}}"/> <span>{{folder.name}}</span></label>
                {{/each}}
            </div>
            {{/if}}
            
            
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.ConditionBrowser.EffectType"}}</h3>
                <label class="filter-check"><input type="checkbox" name="filter-attribute" checked/> <span>{{localize "GUM.ConditionBrowser.Attribute"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-status" checked/> <span>{{localize "GUM.ConditionBrowser.Status"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-chat" checked/> <span>{{localize "GUM.ConditionBrowser.Chat"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-macro" checked/> <span>{{localize "GUM.ConditionBrowser.Macro"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-flag" checked/> <span>{{localize "GUM.ConditionBrowser.Flag"}}</span></label>
            </div>

        </aside>

        <main class="browser-content">
            <ol class="results-list">
                {{#each conditions as |condition|}}
                <li class="result-item" data-item-id="{{condition.id}}">
                    
                    <div class="item-icon">
                        {{#if condition.displayImg}}
                            <img src="{{condition.displayImg}}" alt="{{condition.name}}"/>
                        {{/if}}
                    </div>

                    <div class="item-info">
                        <span class="item-name">{{condition.name}}</span>
                    </div>

                    <div class="item-actions">
                        <button type="button" class="browser-quick-view" data-id="{{condition.id}}" title="{{localize "GUM.ConditionBrowser.ViewTooltip"}}">
                            <i class="fas fa-eye"></i>
                        </button>
                        <label class="item-select" for="condition-{{condition.id}}">
                            <input type="checkbox" name="{{condition.id}}" id="condition-{{condition.id}}" />
                        </label>
                    </div>
                </li>
                {{else}}
                <li class="placeholder-text">{{localize "GUM.ConditionBrowser.NoResults"}}</li>
                {{/each}}
            </ol>
        </main>

    </div>

    <footer class="browser-footer">
        <button type="submit">
            <i class="fas fa-check"></i> {{localize "GUM.ConditionBrowser.AttachSelected"}}
        </button>
    </footer>

</form>
