<form class="modifier-browser-form gum-browser" autocomplete="off">
    <div class="browser-container">
        
        {{!-- SIDEBAR DE FILTROS --}}
        <aside class="browser-sidebar">
            
            {{!-- Busca --}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.GMModifierBrowser.Search"}}</h3>
                <div class="search-box">
                    <input type="text" name="search" placeholder="{{localize "GUM.GMModifierBrowser.SearchPlaceholder"}}">
                    <i class="fas fa-search"></i>
                </div>
            </div>

            {{#if folders.length}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.Common.Folders"}}</h3>
                {{#each folders as |folder|}}
<label class="filter-check folder-filter-check" style="--folder-depth: {{folder.depth}}"><input type="checkbox" name="filter-folder" value="{{folder.id}}"> <span>{{folder.name}}</span></label>
                {{/each}}
            </div>
            {{/if}}

            {{!-- Filtro de Valor --}}
            <div class="filter-group">
                <h3 class="filter-title">{{localize "GUM.GMModifierBrowser.Type"}}</h3>
                <label class="filter-check"><input type="checkbox" name="filter-bonus" checked> <span>{{localize "GUM.GMModifierBrowser.Bonus"}}</span></label>
                <label class="filter-check"><input type="checkbox" name="filter-penalty" checked> <span>{{localize "GUM.GMModifierBrowser.Penalty"}}</span></label>
            </div>
            
            {{!-- Filtro de Categorias --}}
            {{#if categories.length}}
            <div class="filter-group category-filter">
                <h3 class="filter-title">{{localize "GUM.GMModifierBrowser.CategoriesLabel"}}</h3>
                {{#each categories as |category|}}
                <label class="filter-check"><input type="checkbox" value="{{category.id}}"> <span>{{category.label}}</span></label>
                {{/each}}
            </div>
            {{/if}}

        </aside>

        {{!-- LISTA DE RESULTADOS --}}
        <main class="browser-content">
            <ol class="results-list">
                {{#each modifiers}}
                <li class="result-item" data-id="{{this.id}}" data-category="{{this.category}}" data-search="{{this.name}} {{this.categoryLabel}} {{this.displayGroup}}" data-val="{{this.system.modifier}}" data-folder-id="{{this.folderId}}">
                    
                    <div class="item-icon">
                        {{#if this.displayImg}}
                            <img src="{{this.displayImg}}" alt="{{this.name}}"/>
                        {{/if}}
                    </div>

                    <div class="item-info">
                        <span class="item-name">{{this.name}}</span>
                        <span class="item-details">{{this.modifierSubtitle}}</span>
                    </div>

                    <div class="item-actions">
                        <button type="button" class="browser-quick-view" data-id="{{this.id}}" title="{{localize "GUM.GMModifierBrowser.ViewTooltip"}}">
                            <i class="fas fa-eye"></i>
                        </button>
                        <label class="item-select">
                            <input type="checkbox" name="{{this.id}}"/>
                        </label>
                    </div>
                </li>
                {{/each}}
                
                {{#unless modifiers}}
                <li class="placeholder-text">
                    {{localize "GUM.GMModifierBrowser.NoResults"}}
                </li>
                {{/unless}}
            </ol>
        </main>
    </div>

    {{!-- RODAPÉ FIXO --}}
    <footer class="browser-footer">
        <button type="submit"><i class="fas fa-plus-circle"></i> {{localize "GUM.GMModifierBrowser.AddSelected"}}</button>
    </footer>
</form>