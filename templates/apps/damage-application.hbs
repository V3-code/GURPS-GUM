<form class="damage-application-window">
    
    {{!-- 1. CABEÇALHO COM ATACANTE, DANOS E ALVO --}}
    <header class="damage-header">
  <div class="header-row">
    <div class="actor-portrait attacker">
      <img src="{{attacker.img}}" title="{{localize "GUM.DamageApplication.Attacker"}}: {{attacker.name}}"/>
      </div>

    <div class="damage-cards-area">
      {{!-- Card do Dano Principal --}}
      <a class="damage-card active" data-damage-key="main">
        <div class="damage-value">{{damage.main.total}}</div>
        <div class="damage-label">{{#if (gt damage.main.armorDivisor 1)}}({{damage.main.armorDivisor}}){{/if}} {{damage.main.type}}</div>
      </a>
      {{#if damage.followUp.total}}
      <a class="damage-card follow-up" data-damage-key="followUp">
        <div class="damage-value">{{damage.followUp.total}}</div>
        <div class="damage-label">{{#if (gt damage.followUp.armorDivisor 1)}}({{damage.followUp.armorDivisor}}){{/if}} {{damage.followUp.type}}</div>
      </a>
      {{/if}}
      {{#if damage.fragmentation.total}}
      <a class="damage-card fragmentation" data-damage-key="fragmentation">
        <div class="damage-value">{{damage.fragmentation.total}}</div>
        <div class="damage-label">{{#if (gt damage.fragmentation.armorDivisor 1)}}({{damage.fragmentation.armorDivisor}}){{/if}} {{damage.fragmentation.type}}</div>
      </a>
      {{/if}}
    </div>

    <div class="actor-portrait target">
      <img src="{{target.img}}" title="{{localize "GUM.DamageApplication.Target"}}: {{target.name}}"/>
      </div>
  </div>

  <div class="header-row selector-row">
    <select name="damage_target_pool">
      {{#each damageablePools as |pool|}}
        <option value="{{pool.path}}">{{pool.label}}</option>
      {{/each}}
    </select>
  </div>
</header>


    <hr class="header-divider">

    {{!-- 2. CORPO COM 3 COLUNAS --}}
    <main class="damage-app-body">
        <div class="body-column hit-locations-panel">
            <div class="panel-header">{{localize "GUM.DamageApplication.HitLocation"}}</div>
            <div class="locations-table">
                {{!-- Cabeçalho da Tabela de RD --}}
                <div class="location-header">
                    <span>{{localize "GUM.DamageApplication.Roll"}}</span>
                    <span>{{localize "GUM.DamageApplication.Location"}}</span>
                    <span>RD</span>
                    <span class="large-area-header" title="{{localize "GUM.DamageApplication.LargeAreaMarkerHint"}}">{{localize "GUM.DamageApplication.LargeAreaAbbreviation"}}</span>
                </div>
                {{!-- Lista de Locais --}}
                {{#each locations}}
                <div class="location-row {{#if this.isGroup}}is-group{{/if}}" data-location-key="{{this.key}}" data-dr="{{this.totalDR}}">
                    <span class="roll">{{this.roll}}</span>
                    <span class="label">{{this.label}}</span>
                        <span class="dr">
                            {{#if this.custom}}
                                <input type="number" name="custom_dr" value="0" min="0" class="custom-dr-input"/>
                            {{else}}
                                {{this.totalDR}}
                            {{/if}}
                        </span>
                    <span class="large-area-marker" title="{{localize "GUM.DamageApplication.LargeAreaLocationHint"}}"><i class="fas fa-bullseye"></i></span>
                </div>
                {{/each}}
            </div>
            <div class="damage-options">
                <label class="custom-checkbox">
                    <input type="checkbox" name="large_area_injury"/>
                    <span title="{{localize "GUM.DamageApplication.LargeAreaHint"}}">{{localize "GUM.DamageApplication.LargeAreaInjury"}}</span>
                </label>
                <label class="custom-checkbox">
                    <input type="checkbox" name="ignore_dr"/>
                    <span>{{localize "GUM.DamageApplication.IgnoreTargetDR"}}</span>
                </label>
            </div>
        </div>

        
       {{!-- Coluna 2: Modificadores de Ferimento --}}
<div class="body-column wounding-mods-panel">
     <div class="panel-header">{{localize "GUM.DamageApplication.WoundingAndInjury"}}</div>
<div class="wounding-table">
  <div class="wounding-table">
  {{#each woundingModifiers}}
    {{#if (or (eq this.abrev "cort") (eq this.abrev "cont") (eq this.abrev "perf"))}}
      <div class="wounding-row group-1" data-abrev="{{this.abrev}}">
        <label class="custom-radio">
          <input type="radio" name="wounding_mod_type" value="{{this.mult}}" {{#if this.checked}}checked{{/if}}/>
          <span class="type">{{this.type}} ({{this.abrev}})</span>
          <span class="dots"></span>
          <span class="mult">x{{this.mult}}</span>
        </label>
      </div>
    {{/if}}
  {{/each}}

  {{#each woundingModifiers}}
    {{#if (or (eq this.abrev "qmd") (eq this.abrev "cor") (eq this.abrev "tox"))}}
      <div class="wounding-row group-2" data-abrev="{{this.abrev}}">
        <label class="custom-radio">
          <input type="radio" name="wounding_mod_type" value="{{this.mult}}" {{#if this.checked}}checked{{/if}}/>
          <span class="type">{{this.type}} ({{this.abrev}})</span>
          <span class="dots"></span>
          <span class="mult">x{{this.mult}}</span>
        </label>
      </div>
    {{/if}}
  {{/each}}

  {{#each woundingModifiers}}
    {{#if (or (eq this.abrev "pi") (eq this.abrev "pi-") (eq this.abrev "pi+") (eq this.abrev "pi++"))}}
      <div class="wounding-row group-3" data-abrev="{{this.abrev}}">
        <label class="custom-radio">
          <input type="radio" name="wounding_mod_type" value="{{this.mult}}" {{#if this.checked}}checked{{/if}}/>
          <span class="type">{{this.type}} ({{this.abrev}})</span>
          <span class="dots"></span>
          <span class="mult">x{{this.mult}}</span>
        </label>
      </div>
    {{/if}}
  {{/each}}

  </div>
</div>

</div>

        {{!-- Colunas 3 --}}
        <div class="body-column situational-mods-panel">
  <div class="panel-header">{{localize "GUM.DamageApplication.SpecialSituations"}}</div>
  <div class="situational-options">
   
    <label class="custom-checkbox">
        <input type="checkbox" name="special_apply_effects_only" />
        <span title="{{localize "GUM.DamageApplication.EffectsOnlyHint"}}">{{localize "GUM.DamageApplication.ApplyEffectsOnly"}}</span>
    </label>
      
    <label class="custom-checkbox">
      <input type="checkbox" name="special_apply_as_heal" />
      <span title="{{localize "GUM.DamageApplication.HealingHint"}}">{{localize "GUM.DamageApplication.ApplyAsHealing"}}</span>
    </label>
 

  <label class="custom-checkbox">
    <input type="checkbox" name="special_half_damage" />
    <span>{{localize "GUM.DamageApplication.BeyondHalfDamage"}}</span>
  </label>

  <label class="custom-checkbox">
    <input type="checkbox" name="special_explosion"/>
    <span>{{localize "GUM.DamageApplication.ExplosionDamage"}}</span>
    <input type="number" name="special_explosion_distance" min="0" step="1" value="1" style="width: 40px; margin-left: 6px;" title="{{localize "GUM.DamageApplication.ExplosionDistanceHint"}}"/>
  </label>

  <label class="custom-checkbox shock-option {{#if targetIgnoresShock}}is-disabled{{/if}}">
    <input type="checkbox" name="special_apply_shock" {{#unless targetIgnoresShock}}checked{{/unless}} {{#if targetIgnoresShock}}disabled{{/if}}/>
    <span title="{{#if targetIgnoresShock}}{{localize "GUM.DamageApplication.ShockIgnoredHint"}}{{#if ignoreShockSourceNames}}: {{ignoreShockSourceNames}}{{/if}}{{else}}{{localize "GUM.DamageApplication.ShockHint"}}{{/if}}">{{localize "GUM.DamageApplication.ApplyShock"}}</span>
    {{#if targetIgnoresShock}}<small title="{{ignoreShockSourceNames}}">{{localize "GUM.DamageApplication.IgnoredByActiveEffect"}}</small>{{/if}}
  </label>

  <label class="custom-checkbox">
    <input type="checkbox" name="show_impact_effects"/>
    <span>{{localize "GUM.DamageApplication.ShowHitLocationEffects"}}</span>
  </label>

    <label class="custom-checkbox">
    <input type="checkbox" name="special_only_knockback"/>
    <span title="{{localize "GUM.DamageApplication.KnockbackOnlyHint"}}">{{localize "GUM.DamageApplication.KnockbackOnly"}}</span>
  </label>


<div class="injury-tolerance-section">
<label class="custom-select">
  <span>{{localize "GUM.DamageApplication.InjuryTolerance"}}:</span>
  <select name="tolerance_type">
    <option value="">{{localize "GUM.DamageApplication.None"}}</option>
    <option value="nao-vivo">{{localize "GUM.DamageApplication.Unliving"}}</option>
    <option value="homogeneo">{{localize "GUM.DamageApplication.Homogeneous"}}</option>
    <option value="difuso">{{localize "GUM.DamageApplication.Diffuse"}}</option>
  </select>
  
  <div class="injury-reduction-section">
    <label class="custom-checkbox">
      <input type="checkbox" name="damage_reduction_enabled"/>
      <span title="{{localize "GUM.DamageApplication.DamageReductionHint"}}">{{localize "GUM.DamageApplication.DamageReduction"}}</span>
        <label class="custom-reduction-input">
      <input type="number" name="damage_reduction_value" min="2" max="4" step="1" value="2"/>
    </label>
    </label>
  </div>
</label>
</div>



  </div>
</div>

    </main>

    <details class="heavy-defense-advisor" data-status="incomplete">
    <summary class="heavy-defense-title"><i class="fas fa-weight-hanging"></i> {{localize "GUM.DamageApplication.DefenseWeight"}} <span class="heavy-defense-title-hint">{{localize "GUM.DamageApplication.HeavyWeaponDefense"}}</span></summary>
    <div class="heavy-defense-content">
      <div class="heavy-defense-grid">
        <label>
          <span>{{localize "GUM.DamageApplication.AttackWeight"}}</span>
          <input type="number" name="heavy_attack_weight" min="0" step="0.01" value="{{heavyDefense.attackWeight}}" />
        </label>
        <label>
          <span>{{localize "GUM.DamageApplication.TargetBasicLift"}}</span>
          <input type="number" name="heavy_basic_lift" min="0" step="0.01" value="{{heavyDefense.basicLift}}" />
        </label>
        <label>
          <span>{{localize "GUM.DamageApplication.DefenseUsed"}}</span>
          <select name="heavy_defense_item" class="heavy-defense-item-select">
            <option value="manual" data-weight="0">{{localize "GUM.DamageApplication.ManualUnarmed"}}</option>
            {{#each heavyDefense.defenseOptions}}
              <option value="{{this.id}}" data-weight="{{this.weight}}">{{this.name}} ({{this.weight}} kg{{#if this.equipped}}){{/if}}</option>
            {{/each}}
          </select>
        </label>
        <label>
          <span>{{localize "GUM.DamageApplication.DefenseItemWeight"}}</span>
          <input type="number" name="heavy_defense_weight" min="0" step="0.01" value="0" />
        </label>
        <label>
          <span>{{localize "GUM.DamageApplication.Mode"}}</span>
          <select name="heavy_defense_mode" class="heavy-defense-item-select">
            <option value="one-handed">{{localize "GUM.DamageApplication.OneHanded"}}</option>
            <option value="two-handed">{{localize "GUM.DamageApplication.TwoHanded"}}</option>
          </select>
        </label>
        <label>
          <span>{{localize "GUM.DamageApplication.Quality"}}</span>
          <select name="heavy_defense_quality" class="heavy-defense-item-select">
            <option value="normal">{{localize "GUM.DamageApplication.QualityNormal"}}</option>
            <option value="cheap">{{localize "GUM.DamageApplication.QualityCheap"}}</option>
            <option value="fine">{{localize "GUM.DamageApplication.QualityFine"}}</option>
            <option value="veryFine">{{localize "GUM.DamageApplication.QualityVeryFine"}}</option>
          </select>
        </label>
      </div>
      <div class="heavy-defense-summary">{{localize "GUM.DamageApplication.HeavyDefensePrompt"}}</div>
    </div>
  </details>

   <details class="knockback-advisor" data-status="incomplete">
    <summary class="knockback-title"><i class="fas fa-person-falling"></i> {{localize "GUM.DamageApplication.Knockback"}} <span class="knockback-title-hint">{{localize "GUM.DamageApplication.BasicSetPage378"}}</span></summary>
    <div class="knockback-content">
      <div class="knockback-grid">
        <label>
          <span>{{localize "GUM.DamageApplication.TargetSTHP"}}</span>
          <input type="number" name="knockback_target_st" min="0" step="1" value="{{knockback.targetST}}" />
        </label>
        <label class="knockback-checkbox-label">
          <input type="checkbox" name="knockback_use_hp" />
          <span>{{localize "GUM.DamageApplication.UseHP"}}</span>
        </label>
        <label class="knockback-checkbox-label">
          <input type="checkbox" name="knockback_perfect_balance" {{#if knockback.hasPerfectBalance}}checked{{/if}} />
          <span>{{localize "GUM.DamageApplication.PerfectBalance"}}</span>
        </label>
      </div>
      <div class="knockback-summary">{{localize "GUM.DamageApplication.KnockbackPrompt"}}</div>
    </div>
  </details>

    <input type="hidden" name="target_dr" value="0" />

{{!-- ================================== --}}
{{!--  3. RODAPÉ (EFEITOS À ESQUERDA / CÁLCULO À DIREITA) --}}
{{!-- ================================== --}}
<footer class="damage-app-footer">
    <div class="footer-top">
        <div class="footer-column effects-summary">
            <div class="placeholder">{{localize "GUM.DamageApplication.EffectsToApply"}}</div>
        </div>

        <div class="footer-column calculation-summary">
            <div class="calc-group-compact">
                <div class="calc-item-compact">
                    <label>{{localize "GUM.DamageApplication.BasicDamage"}}</label>
                    <input type="number" name="damage_rolled" class="calc-input-compact" min="0" step="1"/>
                </div>
                <div class="calc-item-compact">
                    <label>{{localize "GUM.DamageApplication.Divisor"}}</label>
                    <input type="number" name="armor_divisor" class="calc-input-compact" value="1" min="0.1" step="0.1"/>
                </div>
            </div>

            <div class="calc-group-compact">
                <div class="calc-item-compact">
                    <label>{{localize "GUM.DamageApplication.TargetDR"}}</label>
                    <span class="calc-field-compact" data-field="target_dr">(...)</span>
                </div>
                <div class="calc-item-compact">
                    <label>{{localize "GUM.DamageApplication.Penetrating"}}</label>
                    <span class="calc-field-compact" data-field="penetrating_damage">0</span>
                </div>
            </div>
            
            <div class="calc-item-compact single">
                <label>{{localize "GUM.DamageApplication.WoundingModifier"}}</label>
                <span class="calc-field-compact" data-field="wounding_mod">x1</span>
            </div>

            <div class="calculation-notes">
            </div>
            <div class="final-injury-compact">
                <label>{{localize "GUM.DamageApplication.Injury"}}</label>
                <span data-field="final_injury">0</span>
            </div>
        </div>
    </div>

    <div class="action-bar action-buttons">
        <button type="button" data-action="proposeTests" style="display: none;"><i class="fas fa-dice-d20"></i> {{localize "GUM.DamageApplication.ProposeTests"}}</button>
        <button type="button" data-action="applyAndPublish"><i class="fas fa-bullhorn"></i> {{localize "GUM.DamageApplication.ApplyAndPublish"}}</button>
        <button type="button" data-action="applyAndClose"><i class="fas fa-check"></i> {{localize "GUM.DamageApplication.ApplyAndClose"}}</button>
        <button type="button" data-action="applyAndKeepOpen"><i class="fas fa-sync-alt"></i> {{localize "GUM.DamageApplication.ApplyAndKeepOpen"}}</button>
    </div>
</footer>
