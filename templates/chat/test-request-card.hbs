<article class="gum-test-request">
  <header>
    <span class="request-card-icon"><i class="fas fa-dice"></i></span>
    <div><span class="request-card-kicker">{{localize "GUM.RollRequest.GMRequest"}}</span><h3>{{request.title}}</h3>
    {{#if request.description}}<p>{{request.description}}</p>{{/if}}
    </div>
  </header>
  <div class="request-summary">
    <span class="request-summary-pill"><i class="fas fa-bullseye"></i> {{testLabel}}</span>
    {{#each purposes}}<span class="request-summary-pill purpose"><i class="fas fa-tag"></i> {{this}}</span>{{/each}}
    {{#if request.test.fixedModifier}}<span class="request-summary-pill modifier"><i class="fas fa-lock"></i> {{request.test.fixedModifier}} {{request.test.fixedModifierLabel}}</span>{{/if}}
  </div>
  <div class="request-progress"><div><span>{{localize "GUM.RollRequest.Progress"}}</span><strong>{{progress.answered}} / {{progress.total}}</strong></div><div class="request-progress-track"><span style="width: {{progressPercent}}%"></span></div></div>
  <div class="request-targets">
    {{#each targets}}
    <details class="request-target-row {{#if unavailableReason}}is-unavailable{{/if}}">
      <summary>
        <img src="{{actorImg}}">
        <span>{{actorName}}</span>
        <strong class="request-result request-result-{{response.outcome}}">{{status}}</strong>
      </summary>
      {{#if response}}
      <dl>
        <dt>{{localize "GUM.RollRequest.Dice"}}</dt><dd>{{response.total}}</dd>
        <dt>{{localize "GUM.RollRequest.EffectiveTarget"}}</dt><dd>{{response.effectiveTarget}}</dd>
        <dt>{{localize "GUM.RollRequest.MarginLabel"}}</dt><dd>{{response.margin}}</dd>
        <dt>{{localize "GUM.RollRequest.Base"}}</dt><dd>{{response.baseValue}}</dd>
        {{#if response.defaultLabel}}<dt>{{localize "GUM.RollRequest.Default"}}</dt><dd>{{response.defaultLabel}}</dd>{{/if}}
        <dt>{{localize "GUM.RollRequest.Modifiers"}}</dt><dd>{{#each modifierBreakdown}}<span class="request-modifier-part">{{label}} {{valueLabel}}</span>{{/each}}</dd>
        {{#if responsePurposeLabels}}<dt>{{localize "GUM.RollRequest.Purposes"}}</dt><dd>{{#each responsePurposeLabels}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd>{{/if}}
        <dt>{{localize "GUM.RollRequest.User"}}</dt><dd>{{responseUserName}}</dd>
        <dt>{{localize "GUM.RollRequest.Time"}}</dt><dd>{{submittedAtLabel}}</dd>
      </dl>
      {{#if hasHistory}}<details class="request-history"><summary>{{historyLabel}}</summary>{{#if previous}}<p>{{previousLabel}}</p>{{/if}}</details>{{/if}}
      {{#unless unavailableReason}}<button type="button" class="test-request-roll" data-target-key="{{encodedKey}}" data-replace="true">{{localize "GUM.RollRequest.Reroll"}}</button>{{/unless}}
      {{else}}
        {{#if unavailableReason}}<p class="request-unavailable-reason"><i class="fas fa-triangle-exclamation"></i> {{unavailableReason}}</p>
        {{else}}<button type="button" class="test-request-roll" data-target-key="{{encodedKey}}">{{localize "GUM.RollRequest.RollTest"}}</button>{{/if}}
      {{/if}}
    </details>
    {{/each}}
  </div>
</article>
